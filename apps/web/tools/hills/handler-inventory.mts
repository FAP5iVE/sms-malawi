/**
 * apps/web/tools/hills/handler-inventory.mts
 *
 * [PURPOSE]: Chikangawa Hills theme, Phase 0. Records, per source file, every
 *   behaviour-bearing item (event handlers, API/auth calls, effects, router
 *   calls) plus a digest of the file's whole logic fingerprint. The committed
 *   baseline (docs/hills/handler-inventory.baseline.json) lets anyone, with or
 *   without git history, prove that a later phase changed looks only:
 *
 *     pnpm hills:inventory          rewrite the baseline (do this once, in Phase 0)
 *     pnpm hills:inventory:check    compare the tree with the baseline, exit 1 on drift
 *     pnpm hills:inventory:print    human-readable list (file, line, item) to stdout
 *
 *   Scope: src/app (except api/), src/components, src/hooks. Server code,
 *   actions, lib and store are frozen outright by logic-diff and need no
 *   inventory.
 *
 *   The check reuses the exact fingerprint of logic-diff, so className, JSX
 *   text, markup wrappers and UI imports never cause drift. Intentional
 *   logic changes are declared in logic-allowlist.json and the baseline is
 *   regenerated by the phase that makes them.
 */

import { readFileSync, writeFileSync } from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

import { digestTokens, fingerprint, type Token } from './lib/fingerprint.mjs'
import { walk } from './lib/paths.mjs'

const here = path.dirname(fileURLToPath(import.meta.url))
const webRoot = path.resolve(here, '../..')
const BASELINE = path.join(webRoot, 'docs/hills/handler-inventory.baseline.json')

const inScope = (rel: string): boolean =>
  /^src\/(app|components|hooks)\/.*\.(ts|tsx)$/.test(rel) &&
  !/^src\/app\/api\//.test(rel) &&
  !/(__tests__|\.stories\.|\.test\.)/.test(rel)

interface Item {
  /** handler | call | effect | router | api */
  k: string
  /** attribute or callee name, e.g. onSubmit, apiFetch, signInWithEmailAndPassword */
  n: string
  /** first 8 hex chars of sha1 of the normalised token text */
  h: string
  /** only in --print output */
  line?: number
  text?: string
}
interface FileEntry {
  digest: string
  tokens: number
  items: Item[]
}
type Inventory = Record<string, FileEntry>

const CALL_RE =
  /\b(apiFetch|fetch|signIn\w*|signOut|createUser\w*|sendPasswordResetEmail|confirmPasswordReset|updatePassword|reauthenticate\w*|verifyPasswordResetCode|sanitizeRedirectTarget|handleSubmit|setCookie|document\.cookie)\s*\(/
const ROUTER_RE = /\b(router\.(push|replace|back|refresh|prefetch)|redirect|notFound|window\.location(\.\w+)?)\b/
const EFFECT_RE = /\b(useEffect|useLayoutEffect|useInsertionEffect)\s*\(/
const API_PATH_RE = /['"`](\/api\/[^'"`]*|[^'"`]*log-login[^'"`]*)['"`]/

async function sha8(s: string): Promise<string> {
  const { createHash } = await import('node:crypto')
  return createHash('sha1').update(s).digest('hex').slice(0, 8)
}

async function describe(tokens: Token[]): Promise<Item[]> {
  const items: Item[] = []
  for (const t of tokens) {
    if (t.kind === 'selector') continue
    const h = await sha8(t.text)
    const push = (k: string, n: string) => items.push({ k, n, h, line: t.line, text: t.text })
    const handlerAttr = /^(on[A-Z]\w*)=/.exec(t.text)
    if (handlerAttr) push('handler', handlerAttr[1] as string)
    const call = CALL_RE.exec(t.text)
    if (call) push('call', (call[1] as string).replace(/\s+/g, ''))
    if (EFFECT_RE.test(t.text)) push('effect', (EFFECT_RE.exec(t.text)?.[1]) as string)
    const router = ROUTER_RE.exec(t.text)
    if (router) push('router', router[1] as string)
    const api = API_PATH_RE.exec(t.text)
    if (api) push('api', api[1] as string)
  }
  return items
}

async function build(): Promise<Inventory> {
  const inv: Inventory = {}
  for (const rel of walk(path.join(webRoot, 'src'), () => true, webRoot)) {
    if (!inScope(rel)) continue
    const source = readFileSync(path.join(webRoot, rel), 'utf8')
    const tokens = fingerprint(source, rel)
    const items = await describe(tokens)
    inv[rel] = { digest: await digestTokens(tokens), tokens: tokens.length, items }
  }
  return inv
}

/** Order-insensitive, line-free view of the items for stable baselines. */
const strip = (inv: Inventory): Inventory =>
  Object.fromEntries(
    Object.entries(inv).map(([f, e]) => [
      f,
      {
        digest: e.digest,
        tokens: e.tokens,
        items: e.items
          .map(({ k, n, h }) => ({ k, n, h }))
          .sort((a, b) => `${a.k}${a.n}${a.h}`.localeCompare(`${b.k}${b.n}${b.h}`)),
      },
    ]),
  )

const mode = process.argv[2] ?? '--write'

if (mode === '--print') {
  const inv = await build()
  let total = 0
  for (const [file, e] of Object.entries(inv)) {
    if (e.items.length === 0) continue
    console.log(file)
    for (const i of e.items.sort((a, b) => (a.line ?? 0) - (b.line ?? 0))) {
      total++
      console.log(`  L${i.line} ${i.k}:${i.n}  ${(i.text ?? '').slice(0, 110)}`)
    }
  }
  console.log(`\n${total} items in ${Object.keys(inv).length} files`)
} else if (mode === '--write') {
  const inv = strip(await build())
  writeFileSync(BASELINE, `${JSON.stringify(inv, null, 1)}\n`)
  const items = Object.values(inv).reduce((n, e) => n + e.items.length, 0)
  console.log(`Wrote ${path.relative(webRoot, BASELINE)}: ${Object.keys(inv).length} files, ${items} handler/call items`)
} else if (mode === '--check') {
  const baseline = JSON.parse(readFileSync(BASELINE, 'utf8')) as Inventory
  const now = strip(await build())
  const drift: string[] = []
  for (const f of Object.keys(baseline)) {
    if (!(f in now)) drift.push(`removed  ${f}`)
    else if ((baseline[f] as FileEntry).digest !== (now[f] as FileEntry).digest) {
      const was = new Set((baseline[f] as FileEntry).items.map((i) => `${i.k}:${i.n}:${i.h}`))
      const is = new Set((now[f] as FileEntry).items.map((i) => `${i.k}:${i.n}:${i.h}`))
      const lost = [...was].filter((x) => !is.has(x))
      const gained = [...is].filter((x) => !was.has(x))
      drift.push(
        `changed  ${f}` +
          (lost.length ? `\n           lost handler/call items: ${lost.map((x) => x.split(':').slice(0, 2).join(':')).join(', ')}` : '') +
          (gained.length ? `\n           new handler/call items:  ${gained.map((x) => x.split(':').slice(0, 2).join(':')).join(', ')}` : '') +
          (!lost.length && !gained.length ? '\n           (non-handler logic changed: run hills:logic-diff for the exact lines)' : ''),
      )
    }
  }
  for (const f of Object.keys(now)) if (!(f in baseline)) drift.push(`new      ${f}`)
  if (drift.length === 0) {
    console.log(`Handler inventory matches the baseline (${Object.keys(now).length} files).`)
  } else {
    console.log(`Handler inventory drift in ${drift.length} file(s):\n${drift.join('\n')}`)
    process.exit(1)
  }
} else {
  console.error('Usage: handler-inventory.mts [--write | --check | --print]')
  process.exit(2)
}
