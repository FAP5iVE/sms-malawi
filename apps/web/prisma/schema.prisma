generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── STUDENTS ────────────────────────────────────────────
model Student {
  id               String   @id @default(cuid())
  registrationNo   String   @unique          // auto-generated e.g. SMS-2025-0001
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime
  sex              Sex
  nationality      String   @default("Malawian")
  district         String
  village          String?
  address          String?
  phone            String?
  email            String?
  guardianName     String
  guardianPhone    String
  guardianRelation String
  photoKey         String?
  firebaseUid      String?   @unique   // Firebase Auth UID — set on student account creation
  status           StudentStatus @default(ACTIVE)
  classId          String?
  class            Class?        @relation(fields: [classId], references: [id])
  transcriptKey    String?    // Appwrite file ID for latest transcript
  borrowings       Borrowing[]
  invoices         Invoice[]
  credits          StudentCredit[]
  attendanceRecords Attendance[]
  universityPlacements UniversityPlacement[]   // R18 — advisory university placements
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([classId])
  @@index([status])
  @@index([firebaseUid])
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  AWAITING_MANEB_RESULTS
  GRADUATED
  ARCHIVED
}

enum Sex {
  MALE
  FEMALE
}

// ─── CLASSES ─────────────────────────────────────────────
model Class {
  id          String    @id @default(cuid())
  name        String                       // "Form 1A", "Form 2B", etc.
  form        Int                          // 1, 2, 3, or 4
  stream      String?                      // "A", "B", "Science", "Arts"
  teacherId   String?                      // class teacher Firebase UID
  room        String?
  status      ClassStatus @default(ACTIVE)
  academicYear String                      // "2025/2026"
  students    Student[]
  assignments Assignment[]
  labBookings LabBooking[]
  timetable   TimetableSlot[]
  exams       Exam[]
  subjectAssignments ClassSubjectAssignment[]
  attendanceRecords Attendance[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([form])
  @@index([academicYear])
  @@index([status])
  @@map("classes")
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

// ─── ASSIGNMENTS ─────────────────────────────────────────
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  subject     String
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  dueDate     DateTime
  createdByUid String                     // teacher Firebase UID
  submissions AssignmentSubmission[]
  createdAt   DateTime  @default(now())

  @@index([classId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  fileKey      String?   // Appwrite object key for uploaded file (single-bucket, FILE_PREFIX.ASSIGNMENT_SUBMISSION-namespaced — see lib/storage.ts)
  submittedAt  DateTime  @default(now())
  status       SubmissionStatus @default(SUBMITTED)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  MISSING
}

// ─── ATTENDANCE  ─────────────────────
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  date      DateTime                    // day-granularity; time component always midnight
  status    AttendanceStatus
  markedBy  String                      // Firebase UID of the teacher who marked it —
                                         // application-level validated (Class.teacherId
                                         // match), no DB-level FK across the
                                         // Firebase-UID/Postgres boundary is possible
  createdAt DateTime @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ─── LAB BOOKINGS ─────────────────────────────────────────
model LabBooking {
  id           String    @id @default(cuid())
  classId      String
  class        Class     @relation(fields: [classId], references: [id])
  bookedByUid  String    // teacher Firebase UID
  labName      String    @default("Science Lab")
  date         DateTime
  periodStart  String    // "08:00"
  periodEnd    String    // "09:00"
  purpose      String?
  createdAt    DateTime  @default(now())

  @@index([date])
  @@map("lab_bookings")
}

// ─── APPLICATIONS ────────────────────────────────────────
model Application {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime
  sex              Sex
  nationality      String
  district         String
  village          String?
  guardianName     String
  guardianPhone    String
  email            String?
  phone            String?
  address          String?
  previousSchool   String?
  reasonForTransfer String?
  academicYear     String?
  guardianEmail    String?
  guardianAddress  String?
  guardianRelation String
  applyingForForm  Int               // 1–4
  status           ApplicationStatus @default(PENDING)
  reviewedByUid    String?
  reviewedAt       DateTime?
  notes            String?
  convertedStudentId String?         // set when converted to Student record
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  AWAITING_ADMISSION
  ADMITTED
}

// ─── TIMETABLE ───────────────────────────────────────────
model TimetableSlot {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  day         Weekday
  periodStart String    // "07:30"
  periodEnd   String    // "08:30"
  subject     String
  teacherUid  String
  room        String?
  type        TimetableType @default(REGULAR)
  academicYear String
  term        Int       // 1, 2, or 3
  approvedAt  DateTime?
  approvedByUid String?

  @@index([classId, day])
  @@index([academicYear, term])
  @@map("timetable_slots")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
enum TimetableType {
  REGULAR
  EXAM
  MANEB
  LAB
}

// ─── CLASS SUBJECT ASSIGNMENT ─────────────────────────────
model ClassSubjectAssignment {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String
  teacherUid   String
  academicYear String
  createdByUid String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([classId, subject, academicYear])
  @@index([teacherUid, academicYear])
  @@index([classId, academicYear])
  @@map("class_subject_assignments")
}


// ─── AUDIT LOG ───────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  action     String                         // "student.create", "student.archive"
  entityType String                         // "Student", "Application"
  entityId   String
  actorUid   String
  actorRole  String
  metadata   Json?                          // before/after values
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUid])
  @@map("audit_logs")
}


// ─── FEE STRUCTURE ───────────────────────────────────────
model FeeStructure {
  id           String   @id @default(cuid())
  name         String                        // "Tuition", "Boarding", "Exam", "Uniform", "Library", "Transport"
  amount       Decimal  @db.Decimal(12, 2)   // MWK amount
  classId      String?                       // null = applies to all classes
  academicYear String
  term         Int?                          // null = applies to all terms
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([academicYear, classId])
  @@map("fee_structures")
}

// ─── STUDENT INVOICE (per term per student) ───────────────
model Invoice {
  id              String          @id @default(cuid())
  studentId       String
  academicYear    String
  term            Int
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @db.Decimal(12, 2) @default(0)
  latePenalty     Decimal         @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal         @db.Decimal(12, 2)
  paidAmount      Decimal         @db.Decimal(12, 2) @default(0)
  balance         Decimal         @db.Decimal(12, 2)   // totalAmount - paidAmount
  status          InvoiceStatus   @default(UNPAID)
  dueDate         DateTime
  scholarshipId   String?
  student         Student       @relation(fields: [studentId], references: [id])
  payments        Payment[]
  notes           InvoiceNote[]
  lineItems       InvoiceLineItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([studentId, academicYear, term])   // one invoice per student per term
  @@index([studentId])
  @@index([status])
  @@index([academicYear, term])
  @@map("invoices")
}

enum InvoiceStatus {
    UNPAID
    PARTIAL
    PAID 
    OVERDUE
     }


model InvoiceLineItem {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?  // nullable: the source fee structure, for reference only
  feeName        String
  amount         Decimal  @db.Decimal(12, 2)   // owed for this fee type
  paidAmount     Decimal  @db.Decimal(12, 2) @default(0)
  balance        Decimal  @db.Decimal(12, 2)   // amount - paidAmount
  allocations    PaymentAllocation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}


model PaymentAllocation {
  id         String          @id @default(cuid())
  paymentId  String
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  lineItemId String
  lineItem   InvoiceLineItem @relation(fields: [lineItemId], references: [id])
  amount     Decimal         @db.Decimal(12, 2)
  createdAt  DateTime        @default(now())

  @@index([paymentId])
  @@index([lineItemId])
  @@map("payment_allocations")
}


model StudentCredit {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  amount          Decimal   @db.Decimal(12, 2)   // remaining unapplied balance
  originalAmount  Decimal   @db.Decimal(12, 2)   // what it started as, for the audit trail
  sourcePaymentId String?
  reason          String?
  createdAt       DateTime  @default(now())
  lastAppliedAt   DateTime?

  @@index([studentId])
  @@map("student_credits")
}

// ─── PAYMENT RECORD ──────────────────────────────────────
model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?       // bank ref, mobile money transaction ID
  receiptKey   String?       // R2 object key for generated PDF receipt
  recordedByUid String
  notes        String?
  paidAt       DateTime      @default(now())
  allocations  PaymentAllocation[]

  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
   CASH  
   BANK_TRANSFER  
   MOBILE_MONEY  
   CHEQUE 
   }

// ─── INVOICE NOTES (sticky notes on transactions) ────────
model InvoiceNote {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  body      String
  authorUid String
  createdAt DateTime @default(now())

  @@map("invoice_notes")
}

// ─── EXPENSE ─────────────────────────────────────────────
model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(12, 2)
  receiptKey   String?         // Appwrite file ID for scanned receipt
  academicYear String
  term         Int
  approvedByUid String?
  approvedAt   DateTime?
  status       ExpenseStatus   @default(PENDING)
  recordedByUid String
  incurredAt   DateTime
  createdAt    DateTime        @default(now())
  paidAt       DateTime?
  paidByUid    String?

  @@index([academicYear, term])
  @@index([category])
  @@map("expenses")
}

enum ExpenseCategory { 
  SALARIES  
  UTILITIES  
  MAINTENANCE  
  PROCUREMENT  
  LIBRARY  
  TRANSPORT  
  MISCELLANEOUS 
  }

enum ExpenseStatus  { 
  PENDING  
  APPROVED  
  REJECTED 
  }

// ─── PAYROLL ─────────────────────────────────────────────
model PayrollRun {
  id             String          @id @default(cuid())
  month          Int             // 1–12
  year           Int
  status         PayrollStatus   @default(PROCESSING)
  totalGross     Decimal         @db.Decimal(12, 2)
  totalNet       Decimal         @db.Decimal(12, 2)
  runByUid       String
  submittedByUid String?         // R10 — set on submit-for-approval
  approvedByUid  String?         // R10 — set on approve
  approvedAt     DateTime?       // R10 — set on approve
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  payslips       Payslip[]

  @@unique([month, year])
  @@map("payroll_runs")
}

enum PayrollStatus {
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  LOCKED
  COMPLETED
  FAILED
  }

model Payslip {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id])
  staffUid      String
  staffName     String
  grossSalary   Decimal    @db.Decimal(12, 2)
  paye          Decimal    @db.Decimal(12, 2)  // income tax
  pension       Decimal    @db.Decimal(12, 2)
  loanDeduction Decimal    @db.Decimal(12, 2) @default(0)
  netSalary     Decimal    @db.Decimal(12, 2)
  payslipKey    String?    // R2 object key for PDF payslip
  createdAt     DateTime   @default(now())

  @@index([staffUid])
  @@index([payrollRunId])
  @@map("payslips")
}

// ─── SALARY STRUCTURE ────────────────────────────────────
model SalaryStructure {
  id           String   @id @default(cuid())
  staffUid     String   @unique
  baseSalary   Decimal  @db.Decimal(12, 2)
  allowances   Decimal  @db.Decimal(12, 2) @default(0)
  loanBalance  Decimal  @db.Decimal(12, 2) @default(0)
  monthlyLoanDeduction Decimal @db.Decimal(12, 2) @default(0)
  updatedAt    DateTime @updatedAt

  @@map("salary_structures")
}

model StaffAllowance {
  id           String   @id @default(cuid())
  staffUid     String
  type         String   // free text, e.g. "Housing", "Transport", "Responsibility", "Bonus"
  amount       Decimal  @db.Decimal(12, 2)
  recurring    Boolean  @default(true)
  paidMonth    Int?     // 1-12 — required when recurring = false, ignored when true
  paidYear     Int?
  notes        String?
  createdByUid String
  createdAt    DateTime @default(now())

  @@index([staffUid])
  @@index([staffUid, recurring])
  @@map("staff_allowances")
}

// ─── BUDGET ──────────────────────────────────────────────
model Budget {
  id           String   @id @default(cuid())
  academicYear String
  term         Int?     // null = annual budget
  department   String
  category     ExpenseCategory
  description  String?
  allocated    Decimal  @db.Decimal(12, 2)
  spent        Decimal  @db.Decimal(12, 2) @default(0)
  createdByUid String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([academicYear])
  @@map("budgets")
}

// ─── SCHOLARSHIP / BURSARY ───────────────────────────────
model Scholarship {
  id           String           @id @default(cuid())
  name         String
  studentId    String
  discountType DiscountType
  value        Decimal          @db.Decimal(12, 2)  // % or fixed MWK amount
  academicYear String
  isActive     Boolean          @default(true)
  notes        String?
  createdAt    DateTime         @default(now())

  @@index([studentId])
  @@map("scholarships")
}

enum DiscountType { 
  PERCENTAGE  
  FIXED_AMOUNT 
  }

// ─── INSTALLMENT PLAN ────────────────────────────────────
model InstallmentPlan {
  id           String              @id @default(cuid())
  invoiceId    String              @unique           // one plan per invoice
  totalAmount  Decimal             @db.Decimal(12, 2)
  installments Installment[]
  createdByUid String
  createdAt    DateTime            @default(now())

  @@map("installment_plans")
}

model Installment {
  id        String          @id @default(cuid())
  planId    String
  plan      InstallmentPlan @relation(fields: [planId], references: [id])
  dueDate   DateTime
  amount    Decimal         @db.Decimal(12, 2)
  paidAt    DateTime?
  status    InstallmentStatus @default(PENDING)

  @@index([planId])
  @@map("installments")
}

enum InstallmentStatus { 
  PENDING  
  PAID  
  OVERDUE 
  }

// ─── LIBRARY FINE  ───────────────────────────────────────
model LibraryFine {
  id              String          @id @default(cuid())
  studentId       String?         // R12: made optional — a staff borrower's fine has no studentId (see staffId below)
  staffId         String?         // R12: NEW — plain, non-relational, mirroring studentId's existing established convention on this model (this model has never used a real Prisma @relation for the borrower, per finances.ts's own documented reasoning); populated when the underlying Borrowing is a STAFF loan
  bookTitle       String
  borrowingId     String?         @unique            // R12: NEW — formalizes the borrowingId-shaped FK concept libraryWorkflowService.ts's fine-waiver workflow already assumed existed
  borrowing       Borrowing?      @relation(fields: [borrowingId], references: [id])
  firestoreDocId  String?         @unique            // R10: Firestore is no longer part of this workflow (Prisma is the sole system of record) — kept optional, not dropped, pending R11's explicit confirmation of whether the library domain still needs it for anything else
  amount          Decimal         @db.Decimal(10, 2)
  reason          String
  status          FineStatus      @default(PENDING)
  markedByUid     String          // librarian who raised the fine
  paidAt          DateTime?
  clearedByUid    String?         // finance staff who marked it paid
  createdAt       DateTime        @default(now())
  waivedAt        DateTime?
  waivedByUid     String?
  waiverRequests  FineWaiverRequest[]

  @@index([studentId])
  @@index([staffId])
  @@index([status])
  @@map("library_fines")
}

enum FineStatus { 
  PENDING  
  PAID 
  WAIVED 
  }

  // ─── ACCOUNTING LEDGER (Phase D6) ────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id           String       @id @default(cuid())
  code         String       @unique   // e.g. "1000" Cash, "4000" Fee Revenue
  name         String
  type         AccountType
  category     String?      // sub-group label e.g. "Current Assets"
  isActive     Boolean      @default(true)
  balance      Decimal      @db.Decimal(14, 2) @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lines        JournalLine[]

  @@index([type, isActive])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id           String        @id @default(cuid())
  reference    String        // e.g. "INV-2025-001"
  description  String
  entryDate    DateTime
  isPosted     Boolean       @default(false)
  postedAt     DateTime?
  postedByUid  String?
  lines        JournalLine[]
  createdAt    DateTime      @default(now())

  @@index([entryDate])
  @@index([isPosted])
  @@map("journal_entries")
}

model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Decimal        @db.Decimal(14, 2) @default(0)
  credit         Decimal        @db.Decimal(14, 2) @default(0)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ─── LIBRARY WORKFLOWS (Phase D12) ───────────────────────

model ResourceRecommendation {
  id              String   @id @default(cuid())
  requestedByUid  String
  title           String
  author          String?
  isbn            String?
  type            String   // 'BOOK' | 'EBOOK' | 'JOURNAL' | 'OTHER'
  subject         String?
  reason          String
  status          String   @default("PENDING")
  reviewedByUid   String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([status])
  @@map("resource_recommendations")
}

model FineWaiverRequest {
  id              String       @id @default(cuid())
  fineId          String
  fine            LibraryFine  @relation(fields: [fineId], references: [id])
  requestedByUid  String
  reason          String
  amount          Decimal      @db.Decimal(10, 2)
  status          String       @default("PENDING")
  reviewedByUid   String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([fineId])
  @@index([status])
  @@map("fine_waiver_requests")
}

  // ─── EXAMS ───────────────────────────────────────────────

model Exam {
  id            String     @id @default(cuid())
  type          ExamType
  subject       String
  classId       String
  class         Class      @relation(fields: [classId], references: [id])
  title         String
  date          DateTime
  timeStart     String
  timeEnd       String
  venue         String
  maxMark       Decimal    @db.Decimal(6,2) @default(100)
  weightPercent Decimal    @db.Decimal(5,2) @default(100)
  academicYear  String
  term          Int
  status        ExamStatus @default(SCHEDULED)
  createdByUid  String
  marks         ExamMark[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([classId, term])
  @@index([academicYear, term])
  @@map("exams")
}

enum ExamType {
  WEEKLY_TEST
  ASSIGNMENT
  QUIZ
  MIDTERM
  END_TERM
  MANEB_JCE
  MANEB_MSCE
}

enum ExamStatus {
  SCHEDULED
  IN_PROGRESS
  MARKS_PENDING
  MARKS_DRAFT
  MARKS_FINAL
  RESULTS_APPROVED
  RESULTS_RELEASED
}

model ExamMark {
  id           String    @id @default(cuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id])
  studentId    String
  mark         Decimal?  @db.Decimal(6,2)
  absent       Boolean   @default(false)
  comment      String?
  enteredByUid String
  isDraft      Boolean   @default(true)
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

model TermResult {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  academicYear   String
  term           Int
  totalMark      Decimal  @db.Decimal(6,2)
  average        Decimal  @db.Decimal(5,2)
  grade          String
  position       Int?
  passStatus     Boolean
  subjectResults Json
  attendanceDays Int      @default(0)
  absentDays     Int      @default(0)
  teacherComment String?
  headComment    String?
  reportCardKey  String?
  classPosition    Int       @default(0)
  classTotal       Int       @default(0)
  releasedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacherComments TeacherComment[]

  @@unique([studentId, academicYear, term])
  @@index([classId, academicYear, term])
  @@map("term_results")
}

// ─── TEACHER COMMENT (R8) ─────────────────────────────────
model TeacherComment {
  id           String     @id @default(cuid())
  termResultId String
  termResult   TermResult @relation(fields: [termResultId], references: [id])
  authorUid    String
  comment      String
  createdAt    DateTime   @default(now())

  @@index([termResultId])
  @@map("teacher_comments")
}

model AnnualResult {
