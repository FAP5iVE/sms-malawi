  severity     String    @default("warning")   // "warning" | "critical"
  message      String
  deploymentId String?
  occurredAt   DateTime  @default(now())
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([kind, acknowledged])
}