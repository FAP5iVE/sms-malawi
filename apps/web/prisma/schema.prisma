// ─── UNIVERSITY PLACEMENT ──────────
enum PlacementStatus {
  NOT_STARTED             // no eligibility computed yet
  ELIGIBILITY_COMPUTED    // recommendations generated, no choices recorded
  CHOICES_RECORDED        // student/staff recorded ranked choices
  PLACED                  // an outcome was recorded (self-reported or staff)
  CONFIRMED               // student confirmed they are taking the place
  DECLINED                // student declined the place
  NOT_PLACED              // cycle closed with no placement
}

model UniversityPlacement {
  id                   String          @id @default(cuid())
  studentId            String
  student              Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  manebRecordId        String          @unique
  manebRecord          ManebRecord     @relation(fields: [manebRecordId], references: [id], onDelete: Cascade)
  status               PlacementStatus @default(NOT_STARTED)
  eligibilityComputedAt DateTime?
  placedUniversityId   String?
  placedProgrammeId    String?
  placedUniversityName String?         // free-text (private/foreign, or off-catalogue)
  placedProgrammeName  String?         // free-text
  isVerified           Boolean         @default(false)
  recordedByUid        String?         // Firebase UID of student (self-report) or staff
  verifiedByUid        String?         // Firebase UID of high_rank verifier
  verifiedAt           DateTime?
  notes                String?
  choices              PlacementChoice[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([studentId, status])
  @@map("university_placements")
}

model PlacementChoice {
  id                    String              @id @default(cuid())
  placementId           String
  placement             UniversityPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  rank                  Int                 // 1 = first choice
  universityId          String?
  programmeId           String?
  universityNameFreeText String?
  programmeNameFreeText  String?
  isEligible            Boolean             @default(false)
  score                 Float?              // sort key only; never a pass/fail cutoff
  missingSubjects       String[]            // subjects that blocked eligibility, if any
  createdAt             DateTime            @default(now())

  @@unique([placementId, rank])
  @@map("placement_choices")
}

// ─────────────────SENTRY MONITORING CACHE ───────────────────────────────────────────────

model SentryIssueCache {
  id              String    @id @default(cuid())
  sentryIssueId   String    @unique
  shortId         String?
  title           String
  culprit         String?
  level           String    // error | warning | fatal | info | debug
