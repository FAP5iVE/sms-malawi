  isTeaching            Boolean             @default(false)
  tcmRegistrationNo     String?
  tcmLicenceNo          String?
  tcmLicenceExpiry      DateTime?
  employmentCategory    EmploymentCategory?
  payrollNo             String?             // HR-only
  highestQualification  QualificationLevel?
  qualificationProgram  String?             // programme studied, e.g. "Bachelor of Education" (diploma / degree only)
  trainingRoute         TrainingRoute?      // teaching staff only
  exitReason            StaffExitReason?
  exitDate              DateTime?
  qualifiedSubjects     StaffQualifiedSubject[]
  responsibilities      StaffResponsibility[]
  photoKey            String?        // Appwrite file ID
  salaryStructureId   String?
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  loans               StaffLoan[]
  performanceNotes    PerformanceNote[]
  borrowings          Borrowing[]
  assetAssignments    AssetAssignment[]
  departmentRef       Department?    @relation(fields: [departmentId], references: [id])
  custodianOfRooms    Room[]         @relation("RoomCustodian")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([department])
  @@index([departmentId])
  @@index([contractExpiry])
  @@index([tcmLicenceExpiry])
  @@map("staff_profiles")
}

