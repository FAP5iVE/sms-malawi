  @@index([category])
  @@index([title])
  @@map("books")
}

enum BookCategory {
  TEXTBOOK
  REFERENCE
  FICTION
  NONFICTION
  SCIENCE
  MATHEMATICS
  HUMANITIES
  PAST_PAPER
  OTHER
}

model Borrowing {
  id           String         @id @default(cuid())
  bookId       String
  book         Book           @relation(fields: [bookId], references: [id])
  borrowerType BorrowerType
  issuedByUid  String
  issuedAt     DateTime       @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  status       BorrowStatus   @default(ACTIVE)
  condition    BorrowCondition @default(GOOD)  // R12: set on return — DAMAGED is now persisted distinctly instead of collapsing into a clean RETURNED
  fineAmount   Decimal?       @db.Decimal(8,2)
  fineId       String?        // links to LibraryFine if created
  notes        String?
  studentId    String?
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffId      String?
  staff        StaffProfile? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  libraryFine  LibraryFine?   // R12: reciprocal side of LibraryFine.borrowingId — at most one fine per borrowing
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([studentId])
  @@index([staffId])
  @@index([status])
  @@index([dueDate])
  @@map("borrowings")
}

enum BorrowerType { 
  STUDENT
  STAFF 
  }

enum BorrowStatus { 
  ACTIVE  
  RETURNED  
  OVERDUE  
  LOST 
  }

enum BorrowCondition {
  GOOD
  DAMAGED
  LOST
}

