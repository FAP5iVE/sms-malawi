// ═══════════════════════════════════════════════════════════════
// R20 — Assets & Inventory Management
//
// Physical, non-library assets: furniture, IT/lab/sports/kitchen
// equipment, vehicles, maintenance tools. Books/borrowings stay
// entirely on the existing Book/Borrowing models — this domain
// deliberately does not touch them.
//
// Custody model: an Asset lives IN_STORE until allocated. Each
// allocation/return is a row in AssetAssignment (full history kept,
// mirrors Borrowing's ACTIVE/RETURNED pattern) rather than mutating
// fields on Asset directly, so "who has had this and when" is always
// reconstructable.
//
// Requisition model: AssetRequest is the academic-dept-head-requests,
// finance-approves-or-rejects workflow, mirroring the existing
// ResourceRecommendation pattern in the library domain. An approved
// request is fulfilled by linking it to the Asset that satisfies it
// (either an existing in-store item or a newly registered one) — it
// does not itself create financial/GL entries; that stays a manual
// finance step via the existing accounting module for now (see
// PURPOSE note in packages/shared/types/permissions.ts's assets.*
// block for what's deliberately out of scope this phase).
// ═══════════════════════════════════════════════════════════════

model Asset {
  id               String          @id @default(cuid())
  name             String
  category         AssetCategory
  description      String?
  serialNumber     String?         @unique  // only for individually-serialized items (a laptop, a vehicle) — leave null for bulk/consumable lines
  quantity         Int             @default(1)  // bulk lines (e.g. "40 stacking chairs") track a count; serialized items are always 1
  condition        AssetCondition  @default(GOOD)
  status           AssetStatus     @default(IN_STORE)
  location         String?         // room/department where it's kept while IN_STORE
  acquisitionDate  DateTime?
  acquisitionCost  Decimal?        @db.Decimal(12, 2)   // MWK
  supplier         String?
  warrantyExpiry   DateTime?
  photoKey         String?         // Appwrite file ID — mirrors Book.coverKey
  notes            String?
  createdByUid     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // ── R22 — Structured location / procurement traceability (additive, all nullable) ──
  assetTag              String?              @unique  // authoritative internal identifier — app-level required for new assets, null on unmigrated legacy rows
  classification         AssetClassification?         // FIXED_ASSET vs CONTROLLED_ITEM — app-level required for new assets
  barcodeValue           String?              @unique
  qrCodeValue             String?              @unique
  departmentId           String?
  roomId                 String?
  sourceType              AssetSourceType?             // how this asset entered the register — OPENING_BALANCE for pre-existing rows with unknown origin
  purchaseRequisitionId  String?
  purchaseOrderId        String?
  goodsReceiptLineId     String?

  assignments      AssetAssignment[]
  fulfilledRequests AssetRequest[]
  departmentRef    Department?          @relation(fields: [departmentId], references: [id])
  roomRef          Room?                @relation(fields: [roomId], references: [id])
  purchaseRequisition PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  purchaseOrder    PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptLine GoodsReceiptLine?    @relation(fields: [goodsReceiptLineId], references: [id])
  stocktakeLines   StocktakeLine[]

  @@index([category])
  @@index([status])
  @@index([name])
  @@index([departmentId])
  @@index([roomId])
  @@map("assets")
}

enum AssetCategory {
  FURNITURE
  IT_EQUIPMENT
  LAB_EQUIPMENT
  SPORTS_EQUIPMENT
  KITCHEN_EQUIPMENT
  VEHICLE
  MAINTENANCE_TOOL
  OTHER
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetStatus {
  IN_STORE
  ALLOCATED
  UNDER_REPAIR
  DISPOSED
  LOST
}

model AssetAssignment {
  id                  String              @id @default(cuid())
  assetId             String
  // R22 correction (Artefact 8 §2): historical custody records must survive deletion
  // of the asset or staff row they reference — was Cascade, now Restrict.
  asset               Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedToType       AssetAssigneeType
  staffId             String?             // set when assignedToType = STAFF
  staff               StaffProfile?       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  departmentOrRoom     String?            // legacy free-text — set when assignedToType = DEPARTMENT or ROOM, retained for compatibility
  departmentId        String?             // structured — set when assignedToType = DEPARTMENT
  roomId              String?             // structured — set when assignedToType = ROOM
  quantity            Int                 @default(1)
  assignedByUid       String
  assignedAt          DateTime            @default(now())
  returnedAt          DateTime?
  status              AssetAssignmentStatus @default(ACTIVE)
  conditionOnReturn   AssetCondition?
  notes               String?

  departmentRef       Department?         @relation(fields: [departmentId], references: [id])
  roomRef             Room?               @relation(fields: [roomId], references: [id])

  @@index([assetId])
  @@index([staffId])
  @@index([status])
  @@index([departmentId])
  @@index([roomId])
  @@map("asset_assignments")
}

enum AssetAssigneeType {
  STAFF
  DEPARTMENT
  ROOM
}

enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
}

model AssetRequest {
  id               String            @id @default(cuid())
  requestedByUid   String
  title            String            // short description, e.g. "10 microscopes for Form 3 Biology"
  category         AssetCategory
  quantity         Int               @default(1)
  department       String?
  justification    String?
  status           AssetRequestStatus @default(PENDING)
  reviewedByUid    String?
  reviewedAt       DateTime?
  reviewNotes      String?
  fulfilledAssetId String?
  fulfilledAsset   Asset?            @relation(fields: [fulfilledAssetId], references: [id])
  advances         AssetAdvance[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // R22 — legacy bridge fields (Artefact 8 §7). AssetRequest is NOT renamed or
  // folded into PurchaseRequisition; it stays the legacy request workflow, with
  // optional structured references for reporting/backfill continuity.
  departmentId     String?
  budgetWindowId   String?
  budgetId         String?

  departmentRef    Department?       @relation(fields: [departmentId], references: [id])
  budgetWindow     BudgetWindow?     @relation(fields: [budgetWindowId], references: [id])
  budgetRef        Budget?           @relation(fields: [budgetId], references: [id])

  @@index([status])
  @@index([requestedByUid])
  @@index([departmentId])
  @@map("asset_requests")
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

// ═══════════════════════════════════════════════════════════
// R21 — Asset Procurement Advances
//
// "Advances management" for the assets domain, scoped narrowly per the
// R20 follow-up conversation: cash finance advances to a SUPPLIER against
// an approved AssetRequest, tracked until the item arrives (reconciled)
// or the advance is written off. Deliberately NOT double-entry accounting
// — no AccountEntry/GL rows are created here (same boundary as
// acquisitionCost on Asset itself, see assetService.ts's file header).
// This is a tracking record so finance can answer "how much is currently
// out the door and unreconciled", not a ledger.
// ═══════════════════════════════════════════════════════════

model AssetAdvance {
  id              String             @id @default(cuid())
  assetRequestId  String
  assetRequest    AssetRequest       @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)
  supplier        String
  amount          Decimal            @db.Decimal(12, 2)   // MWK
  advancedByUid   String
  advancedAt      DateTime           @default(now())
  status          AssetAdvanceStatus @default(PENDING)
  reconciledByUid String?
  reconciledAt    DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([assetRequestId])
  @@index([status])
  @@map("asset_advances")
}

enum AssetAdvanceStatus {
  PENDING
  RECONCILED
  WRITTEN_OFF
}
// ═══════════════════════════════════════════════════════════════════
// R22 — Assets/Inventory/Procurement redesign (additive domain)
//
// Reconciled from the partner's 20-artefact design process (Artefacts
// 4-20) against the actual R20/R21 Assets foundation above. Deviations
// from the partner's draft code/docs, and why, are called out inline.
//
// Scope: Department/Building/Room, Budget Windows & Commitments,
// full Purchase Requisition → RFQ → Quotation → PO → Goods Receipt
// lifecycle, transaction-derived Inventory, and termly Stocktakes.
//
// Nothing above this block was removed. No existing table is dropped,
// no existing column is deleted, Budget.spent and Expense's existing
// approval behaviour are untouched. AssetRequest/AssetAdvance remain
// as legacy bridges, not replaced by PurchaseRequisition.
// ═══════════════════════════════════════════════════════════════════

// ─── LOCATIONS ────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff                StaffProfile[]
  budgets              Budget[]
  assets               Asset[]
  assignments          AssetAssignment[]
  assetRequests        AssetRequest[]
  purchaseRequisitions PurchaseRequisition[]
  rooms                Room[]
  budgetWindows        BudgetWindow[]
  stocktakes           Stocktake[]
  inventoryTransactions InventoryTransaction[]

  @@map("departments")
}

model Building {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@map("buildings")
}

model Room {
  id           String   @id @default(cuid())
  buildingId   String
  code         String
  name         String
  roomType     String
  departmentId String?
  custodianUid String?  // physical accountability only — does NOT grant financial approval (Artefact 8 §11)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  building    Building      @relation(fields: [buildingId], references: [id])
  department  Department?   @relation(fields: [departmentId], references: [id])
  custodian   StaffProfile? @relation("RoomCustodian", fields: [custodianUid], references: [uid])

  assets               Asset[]
  assignments          AssetAssignment[]
  stocktakes           Stocktake[]
  inventoryTransactionsFrom InventoryTransaction[] @relation("InventorySourceRoom")
  inventoryTransactionsTo   InventoryTransaction[] @relation("InventoryDestinationRoom")

  @@unique([buildingId, code])
  @@index([departmentId])
  @@index([custodianUid])
  @@map("rooms")
}

// ─── BUDGET WINDOWS & COMMITMENTS ────────────────────────

enum BudgetWindowType {
  ANNUAL
  TERM
  QUARTERLY
  MONTHLY
  CUSTOM
}

enum BudgetWindowStatus {
  DRAFT
  OPEN
  REVIEW
  CLOSED
  ARCHIVED
}

model BudgetWindow {
  id              String             @id @default(cuid())
  name            String
  academicYear    String
  term            Int?
  type            BudgetWindowType
  status          BudgetWindowStatus @default(DRAFT)
  submissionStart DateTime
  submissionEnd   DateTime
  reviewStart     DateTime?
  reviewEnd       DateTime?
  approvalStart   DateTime?
  approvalEnd     DateTime?
  departmentId    String?            // null = school-wide window
  isActive        Boolean            @default(true)
  createdByUid    String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  department           Department?            @relation(fields: [departmentId], references: [id])
  budgets              Budget[]
  assetRequests        AssetRequest[]
  purchaseRequisitions PurchaseRequisition[]
  commitments          BudgetCommitment[]

  @@index([academicYear, term, status])
  @@index([departmentId])
  @@map("budget_windows")
}

enum BudgetCommitmentStatus {
  RESERVED
  COMMITTED
  CONSUMED
  RELEASED
  CANCELLED
}

model BudgetCommitment {
  id                    String                 @id @default(cuid())
  budgetId              String
  budgetWindowId        String?
  purchaseRequisitionId String?
  purchaseOrderId       String?
  expenseId             String?
  amount                Decimal                @db.Decimal(12, 2)
  status                BudgetCommitmentStatus @default(RESERVED)
  createdByUid          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  budget              Budget               @relation(fields: [budgetId], references: [id])
  budgetWindow        BudgetWindow?        @relation(fields: [budgetWindowId], references: [id])
  purchaseRequisition PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  purchaseOrder       PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  expense             Expense?             @relation(fields: [expenseId], references: [id])

  // Artefact 6 §13 / Artefact 8 §14: duplicate reservation of the same obligation
  // must be prevented. A DB-level unique constraint can't express this correctly
  // here (both FKs are nullable, and Postgres treats NULLs as distinct, so it
  // would silently not fire in the common case). Enforce it in the service layer
  // instead: check for an existing RESERVED/COMMITTED commitment against the same
  // purchaseRequisitionId or purchaseOrderId inside the same transaction that
  // creates a new one.
  @@index([budgetId, status])
  @@index([purchaseRequisitionId])
  @@index([purchaseOrderId])
  @@index([expenseId])
  @@map("budget_commitments")
}

// ─── PROCUREMENT ──────────────────────────────────────────

enum AssetClassification {
  FIXED_ASSET
  CONTROLLED_ITEM
}

enum AssetSourceType {
  PROCUREMENT
  OPENING_BALANCE
  DONATION
  TRANSFER
  OTHER
}

enum ProcurementSource {
  PROCUREMENT
  DIRECT
}

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  CLOSED  // set once every linked PurchaseOrder reaches FULLY_RECEIVED/CLOSED — a summary marker, not a second source of truth for PO/receipt state
}

enum ProcurementLineClassification {
  FIXED_ASSET
  INVENTORY
  CONSUMABLE
  SERVICE
  DIRECT_EXPENSE
}

model PurchaseRequisition {
  id                String            @id @default(cuid())
  requisitionNumber String            @unique  // e.g. PR-2026-0001 — human-readable, id remains the real PK
  departmentId      String
  budgetWindowId    String?
  budgetId          String?
  requestedByUid    String
  purpose           String
  justification     String?
  isEmergency       Boolean           @default(false)
  status            ProcurementStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedByUid     String?
  reviewedAt        DateTime?
  approvedByUid     String?
  approvedAt        DateTime?
  rejectedByUid     String?
  rejectedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  department    Department                @relation(fields: [departmentId], references: [id])
  budgetWindow  BudgetWindow?             @relation(fields: [budgetWindowId], references: [id])
  budget        Budget?                   @relation(fields: [budgetId], references: [id])
  lines         PurchaseRequisitionLine[]
  commitments   BudgetCommitment[]
  rfqs          RFQ[]
  purchaseOrders PurchaseOrder[]
  assets        Asset[]

  @@index([departmentId, status])
  @@index([budgetWindowId, status])
  @@index([requestedByUid])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                      String                         @id @default(cuid())
  purchaseRequisitionId   String
  description             String
  category                String?
  classification          ProcurementLineClassification
  quantity                Decimal                        @db.Decimal(12, 2)
  unitOfMeasure           String
  estimatedUnitCost       Decimal                        @db.Decimal(12, 2)
  estimatedTotal          Decimal                        @db.Decimal(12, 2)
  preferredSpecification  String?
  notes                   String?
  budgetId                String?  // optional per-line budget override, when a requisition draws from more than one budget
  // Required when classification is FIXED_ASSET/CONTROLLED_ITEM — Asset.category
  // is a strict, non-nullable enum with no default, so this must be captured up
  // front rather than guessed at goods-receipt time (validated in procurementService).
  assetCategory           AssetCategory?

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  budget              Budget?             @relation(fields: [budgetId], references: [id])
  rfqLines            RFQLine[]
  quotationLines      QuotationLine[]
  purchaseOrderLines  PurchaseOrderLine[]

  @@index([purchaseRequisitionId])
  @@index([budgetId])
  @@map("purchase_requisition_lines")
}

model Supplier {
  id            String   @id @default(cuid())
  supplierCode  String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  bankDetails   String?  // access to this field must be permission-restricted at the service layer
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@map("suppliers")
}

enum RFQStatus {
  DRAFT
  ISSUED
  RESPONSES_RECEIVED
  CLOSED
  CANCELLED
}

model RFQ {
  id                    String    @id @default(cuid())
  rfqNumber             String    @unique
  purchaseRequisitionId String
  status                RFQStatus @default(DRAFT)
  issueDate             DateTime?
  responseDeadline      DateTime?
  createdByUid          String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  lines               RFQLine[]
  quotations          Quotation[]

  @@index([purchaseRequisitionId])
  @@index([status])
  @@map("rfqs")
}

// Deliberately thin: quantity only. Description/spec/unit live on the
// PurchaseRequisitionLine it points to — avoids a second mutable copy
// of the same line data (Artefact 6 §17).
model RFQLine {
  id                        String   @id @default(cuid())
  rfqId                     String
  purchaseRequisitionLineId String
  quantity                  Decimal  @db.Decimal(12, 2)

  rfq                 RFQ                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  purchaseRequisitionLine PurchaseRequisitionLine @relation(fields: [purchaseRequisitionLineId], references: [id])

  @@index([rfqId])
  @@index([purchaseRequisitionLineId])
  @@map("rfq_lines")
}

enum QuotationStatus {
  RECEIVED
  UNDER_REVIEW
  SELECTED
  REJECTED
  EXPIRED
}

model Quotation {
  id              String          @id @default(cuid())
  rfqId           String
  supplierId      String
  quotationNumber String          @unique
  quotationDate   DateTime
  validUntil      DateTime?
  currency        String          @default("MWK")  // imported equipment is often quoted in USD/ZAR
  subtotal        Decimal         @db.Decimal(12, 2)
  tax             Decimal         @db.Decimal(12, 2) @default(0)
  total           Decimal         @db.Decimal(12, 2)
  status          QuotationStatus @default(RECEIVED)
  documentKey     String?         // Appwrite file ID for the scanned/uploaded quotation
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rfq            RFQ             @relation(fields: [rfqId], references: [id])
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  lines          QuotationLine[]
  purchaseOrders PurchaseOrder[]

  @@index([rfqId])
  @@index([supplierId, status])
  @@map("quotations")
}

model QuotationLine {
  id                        String  @id @default(cuid())
  quotationId               String
  purchaseRequisitionLineId String
  description                String
  quantity                   Decimal @db.Decimal(12, 2)
  unitPrice                  Decimal @db.Decimal(12, 2)
  tax                         Decimal? @db.Decimal(12, 2)
  total                       Decimal @db.Decimal(12, 2)
  notes                       String?

  quotation               Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  purchaseRequisitionLine PurchaseRequisitionLine @relation(fields: [purchaseRequisitionLineId], references: [id])

  @@index([quotationId])
  @@index([purchaseRequisitionLineId])
  @@map("quotation_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  CLOSED
  CLOSED_WITH_VARIANCE
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  poNumber              String              @unique
  purchaseRequisitionId String
  supplierId            String
  quotationId           String?             // nullable: emergency/sole-source POs may skip quotation comparison
  status                PurchaseOrderStatus @default(DRAFT)
  orderDate             DateTime?
  expectedDeliveryDate  DateTime?
  subtotal              Decimal             @db.Decimal(12, 2)
  tax                   Decimal             @db.Decimal(12, 2) @default(0)
  total                 Decimal             @db.Decimal(12, 2)
  approvedByUid         String?
  approvedAt            DateTime?
  createdByUid          String
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  quotation           Quotation?          @relation(fields: [quotationId], references: [id])
  lines               PurchaseOrderLine[]
  goodsReceipts       GoodsReceipt[]
  expenses            Expense[]
  commitments         BudgetCommitment[]
  assets              Asset[]

  @@index([purchaseRequisitionId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                        String                         @id @default(cuid())
  purchaseOrderId           String
  purchaseRequisitionLineId String?
  description               String
  classification            ProcurementLineClassification
  quantityOrdered           Decimal                        @db.Decimal(12, 2)
  unitOfMeasure             String
  unitPrice                 Decimal                        @db.Decimal(12, 2)
  tax                       Decimal?                       @db.Decimal(12, 2)
  lineTotal                 Decimal                        @db.Decimal(12, 2)
  quantityReceived          Decimal                        @db.Decimal(12, 2) @default(0)
  quantityCancelled         Decimal                        @db.Decimal(12, 2) @default(0)
  notes                     String?
  assetCategory             AssetCategory?  // carried forward from the requisition line — see PurchaseRequisitionLine.assetCategory

  purchaseOrder           PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseRequisitionLine PurchaseRequisitionLine? @relation(fields: [purchaseRequisitionLineId], references: [id])
  goodsReceiptLines       GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([purchaseRequisitionLineId])
  @@map("purchase_order_lines")
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  PARTIAL
  COMPLETED
  REJECTED
}

model GoodsReceipt {
  id                         String             @id @default(cuid())
  receiptNumber              String             @unique
  purchaseOrderId            String
  receivedAt                 DateTime           @default(now())
  receivedByUid              String
  status                     GoodsReceiptStatus @default(RECEIVED)
  supplierDeliveryReference  String?
  notes                      String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceiptLine[]
  expenses      Expense[]

  @@index([purchaseOrderId])
  @@index([receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  quantityReceived    Decimal  @db.Decimal(12, 2)
  quantityAccepted    Decimal  @db.Decimal(12, 2)
  quantityRejected    Decimal  @db.Decimal(12, 2) @default(0)
  condition           String?
  notes               String?

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  assets            Asset[]           // one row per serialized unit received on this line
  inventoryTransactions InventoryTransaction[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

// ─── INVENTORY (transaction-derived — no separate mutable balance) ──

model InventoryItem {
  id              String   @id @default(cuid())
  itemCode        String   @unique
  name            String
  category        String?
  description     String?
  unitOfMeasure   String
  reorderLevel    Decimal? @db.Decimal(12, 2)
  reorderQuantity Decimal? @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions   InventoryTransaction[]
  stocktakeLines StocktakeLine[]

  @@map("inventory_items")
}

enum InventoryTransactionType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  RETURN
  TRANSFER
  ADJUSTMENT
  DAMAGE
  LOSS
  DISPOSAL
}

model InventoryTransaction {
  id                 String                    @id @default(cuid())
  inventoryItemId    String
  transactionType    InventoryTransactionType
  quantity           Decimal                   @db.Decimal(12, 2)  // always positive; sign of the effect is implied by transactionType
  departmentId       String?
  sourceRoomId       String?
  destinationRoomId  String?
  goodsReceiptLineId String?
  referenceType      String?   // loose polymorphic pointer, e.g. "GoodsReceiptLine", "Stocktake" — deliberately not a hard FK (Artefact 6 §21)
  referenceId        String?
  performedByUid     String
  reason             String?
  createdAt          DateTime                  @default(now())

  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  sourceRoom       Room?             @relation("InventorySourceRoom", fields: [sourceRoomId], references: [id])
  destinationRoom  Room?             @relation("InventoryDestinationRoom", fields: [destinationRoomId], references: [id])
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([departmentId, createdAt])
  @@index([sourceRoomId])
  @@index([destinationRoomId])
  @@map("inventory_transactions")
}

// ─── STOCKTAKE ────────────────────────────────────────────

enum StocktakeStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  COMPLETED
  CANCELLED
}

model Stocktake {
  id               String          @id @default(cuid())
  stocktakeNumber  String          @unique
  academicYear     String
  term             Int?
  departmentId     String?
  roomId           String?
  custodianUid     String?         // snapshot of the room custodian at open time — not a live FK, mirrors auditService's actorRole snapshot convention
  status           StocktakeStatus @default(DRAFT)
  startedAt        DateTime?
  startedByUid     String?
  completedAt      DateTime?
  completedByUid   String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  department Department?          @relation(fields: [departmentId], references: [id])
  room       Room?                @relation(fields: [roomId], references: [id])
  lines      StocktakeLine[]
  variances  InventoryVariance[]

  @@unique([academicYear, term, roomId])
  @@index([departmentId])
  @@index([roomId])
  @@index([status])
  @@map("stocktakes")
}

model StocktakeLine {
  id               String   @id @default(cuid())
  stocktakeId      String
  inventoryItemId  String?
  assetId          String?
  expectedQuantity Decimal  @db.Decimal(12, 2)
  actualQuantity   Decimal  @db.Decimal(12, 2)
  condition        AssetCondition?
  notes            String?

  stocktake     Stocktake          @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  asset         Asset?             @relation(fields: [assetId], references: [id])
  variance      InventoryVariance?

  @@index([stocktakeId])
  @@index([inventoryItemId])
  @@index([assetId])
  @@map("stocktake_lines")
}

enum VarianceType {
  SHORTAGE
  SURPLUS
}

enum VarianceStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  WRITTEN_OFF
}

model InventoryVariance {
  id               String         @id @default(cuid())
  stocktakeId      String
  stocktakeLineId  String         @unique
  varianceQuantity Decimal        @db.Decimal(12, 2)  // actualQuantity - expectedQuantity, signed
  varianceType     VarianceType
  status           VarianceStatus @default(OPEN)
  reason           String?
  resolvedByUid    String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime       @default(now())

  stocktake     Stocktake     @relation(fields: [stocktakeId], references: [id])
  stocktakeLine StocktakeLine @relation(fields: [stocktakeLineId], references: [id])

  @@index([stocktakeId, status])
  @@map("inventory_variances")
}

// ─── LEGACY MAPPING (backfill audit trail — Artefacts 9/10) ──

enum LegacyMappingType {
  DEPARTMENT  // canonicalizes StaffProfile.department, Budget.department, AssetRequest.department
  LOCATION    // canonicalizes Asset.location, AssetAssignment.departmentOrRoom -> a Room (or, per targetType, a Department)
}

enum LegacyMappingStatus {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
}

model LegacyMapping {
  id              String              @id @default(cuid())
  mappingType     LegacyMappingType
  normalizedValue String              // normalize(legacyValue) — what applyApprovedMappings matches source records against
  legacyValue     String              // one representative raw spelling, for human review
  targetType      String
  targetId        String
  status          LegacyMappingStatus @default(PROPOSED)
  notes           String?
  reviewedByUid   String?
  reviewedAt      DateTime?
  appliedAt       DateTime?
  recordsAffected Int?                // populated once applied — how many source rows were bulk-updated
  createdByUid    String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([mappingType, normalizedValue])
  @@index([mappingType, status])
  @@index([targetType, targetId])
  @@map("legacy_mappings")
}

// ═══════════════════════════════════════════════════════════════════════════
// GUARDIAN PORTAL
//
// Three layers, kept apart on purpose:
//   1. ACCOUNT      Firebase Auth user with role 'parent' (GuardianProfile.firebaseUid)
//   2. PERSON       GuardianProfile + GuardianContact: who this human is
//   3. RELATIONSHIP GuardianLink: which child they may see, and what
//
// StudentGuardian (above) is the school's CONTACT CARD for a student. It is
// edited by staff, may be wrong or stale, and NEVER grants access by itself.
// Only an ACTIVE GuardianLink does, and only after a human verified it.
// GuardianLink.directoryEntryId records which contact card a link was proposed
// from; editing or deleting the card flags or suspends the link (see
// guardianDirectorySync), it never rewrites the person.
// ═══════════════════════════════════════════════════════════════════════════

enum GuardianProfileStatus {
  ACTIVE
  SUSPENDED   // staff froze the person; every link is unusable while this holds
  MERGED      // folded into mergedIntoId; kept for audit, never used for access
}

enum GuardianContactKind {
  PHONE
  EMAIL
}

enum GuardianContactVerification {
  UNVERIFIED       // copied from a contact card, nobody has checked it
  STAFF_CONFIRMED  // staff confirmed it with the person
  CODE_VERIFIED    // the person proved control by redeeming a one-time code
}

enum GuardianLinkStatus {
  PENDING     // proposed (admission, staff, backfill). Grants NOTHING.
  ACTIVE      // verified and approved. Access limited to `capabilities`.
  SUSPENDED   // reversible stop (e.g. directory entry removed, safeguarding hold)
  REVOKED     // ended by staff. Row kept for history.
  REJECTED    // a PENDING proposal staff declined
}

enum GuardianLinkSource {
  ADMISSION       // proposed when the student or guardian card was created
  STAFF           // staff added or proposed it later
  BACKFILL        // created by an onboarding batch from existing contact cards
  PARENT_REQUEST  // the guardian asked for it; staff approved
}

enum GuardianEvidence {
  NONE
  DOCUMENT_SEEN        // staff saw an identifying or relationship document
  IN_PERSON_VERIFIED   // staff verified the person face to face
}

enum GuardianInvitationChannel {
  EMAIL   // code delivered to the intended email; the claim must use that email
  SLIP    // printed slip handed to the person in the office
}

enum GuardianInvitationStatus {
  ACTIVE
  CLAIMED
  REVOKED
  EXPIRED
  LOCKED   // too many wrong attempts; staff must reissue
}

enum GuardianRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GuardianBatchStatus {
  DRY_RUN       // report only; nothing but this batch's own rows were written
  APPLYING      // apply started; call apply again to resume (large schools are applied in chunks)
  APPLIED       // every reviewed item has been processed
  ROLLED_BACK
}

enum GuardianBatchItemAction {
  CREATE_NEW      // new profile + PENDING link
  SUGGEST_MATCH   // existing profile looks like the same person: PENDING link flagged for review
  SKIP_EXISTING   // this contact card already has a link
  SKIP_INVALID    // unusable contact card (no name / no usable phone); reported, not created
}

/// A real person who looks after one or more students. One profile per human,
/// however many children they have. `firebaseUid` is set only once they claim.
model GuardianProfile {
  id             String                @id @default(cuid())
  fullName       String
  normalizedName String                // lower-case, no titles/punctuation: matching only
  status         GuardianProfileStatus @default(ACTIVE)
  firebaseUid    String?               @unique
  claimedAt      DateTime?
  createdSource  GuardianLinkSource    @default(ADMISSION)
  mergedIntoId   String?
  mergedInto     GuardianProfile?      @relation("GuardianMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom     GuardianProfile[]     @relation("GuardianMerge")
  createdByUid   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  contacts       GuardianContact[]
  links          GuardianLink[]        @relation("GuardianLinkProfile")
  suggestedFor   GuardianLink[]        @relation("GuardianLinkSuggestion")
  requests       GuardianLinkRequest[]
  accessLogs     GuardianAccessLog[]

  @@index([normalizedName])
  @@index([status])
  @@map("guardian_profiles")
}

/// A phone number or email belonging to a profile. Two profiles may legitimately
/// share a number (one family phone), so a match on `normalizedValue` is only ever
/// a SUGGESTION for staff, never an automatic merge or grant.
model GuardianContact {
  id              String                      @id @default(cuid())
  profileId       String
  profile         GuardianProfile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind            GuardianContactKind
  value           String                      // as the school recorded it
  normalizedValue String                      // E.164 (+265...) for PHONE, lower-cased for EMAIL
  verification    GuardianContactVerification @default(UNVERIFIED)
  verifiedAt      DateTime?
  isPreferred     Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  invitations     GuardianInvitation[]

  @@unique([profileId, kind, normalizedValue])
  @@index([kind, normalizedValue])
  @@map("guardian_contacts")
}

/// THE ACCESS GRANT: "this person may see this child, for these things".
/// Evaluated on every parent request (never cached into a token). Restrict on
/// delete: a student with links cannot be hard-deleted by accident.
model GuardianLink {
  id                  String             @id @default(cuid())
  profileId           String
  profile             GuardianProfile    @relation("GuardianLinkProfile", fields: [profileId], references: [id], onDelete: Restrict)
  studentId           String
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  relationship        String             // value from GUARDIAN_RELATIONSHIPS
  relationshipNote    String?            // original wording when it had to be mapped to 'Other'
  status              GuardianLinkStatus @default(PENDING)
  source              GuardianLinkSource @default(ADMISSION)
  evidence            GuardianEvidence   @default(NONE)
  /// Subset of: results, fees, attendance, notices, profile, documents.
  /// Empty means nothing, even while ACTIVE. Validated in guardianCapabilities.
  capabilities        String[]           @default([])
  isPrimaryContact    Boolean            @default(false)
  isFinancialResponsible Boolean         @default(false)

  /// Provenance only: the contact card this was proposed from.
  /// UNIQUE: one proposal per contact card. This is what makes concurrent syncs and
  /// overlapping backfill runs race-safe (the loser gets a unique violation, not a duplicate).
  directoryEntryId    String?            @unique
  directoryEntry      StudentGuardian?   @relation(fields: [directoryEntryId], references: [id], onDelete: SetNull)

  /// Staff must look at this link again before it is relied on.
  reverifyRequired    Boolean            @default(false)
  reverifyReason      String?
  /// The contact-card values staff last verified ({ fullName, relation, phone,
  /// altPhone, email }). Drift = this vs the card now (detectDirectoryDrift), so a
  /// missed hook can never hide an edit: the reconcile pass recomputes it.
  verifiedSnapshot    Json?
  /// Matching found an existing profile that may be the same person.
  suggestedProfileId  String?
  suggestedProfile    GuardianProfile?   @relation("GuardianLinkSuggestion", fields: [suggestedProfileId], references: [id], onDelete: SetNull)
  suggestedMethod     String?

  statusReason        String?
  createdByUid        String?
  approvedByUid       String?
  approvedAt          DateTime?
  statusChangedByUid  String?
  statusChangedAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  invitations         GuardianInvitation[]
  accessLogs          GuardianAccessLog[]

  @@unique([profileId, studentId])
  @@index([studentId, status])
  @@index([profileId, status])
  @@index([status, reverifyRequired])
  @@map("guardian_links")
}

/// One-time claim code for one link. Only a keyed hash of the secret is stored.
/// The printed/emailed code is `<ref>-<secret>`: `ref` locates this row, the secret
/// is verified in constant time, and wrong guesses count against THIS row so an
/// attacker cannot brute-force without locking it.
model GuardianInvitation {
  id            String                    @id @default(cuid())
  ref           String                    @unique
  secretHash    String
  linkId        String
  link          GuardianLink              @relation(fields: [linkId], references: [id], onDelete: Cascade)
  channel       GuardianInvitationChannel
  contactId     String?
  contact       GuardianContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status        GuardianInvitationStatus  @default(ACTIVE)
  expiresAt     DateTime
  failedAttempts Int                      @default(0)
  lockedAt      DateTime?
  issuedByUid   String
  issuedAt      DateTime                  @default(now())
  sentAt        DateTime?
  claimedAt     DateTime?
  claimedByUid  String?
  revokedAt     DateTime?
  revokedByUid  String?

  @@index([linkId, status])
  @@index([status, expiresAt])
  @@map("guardian_invitations")
}

/// A guardian asking for access to a child. Staff verify and approve; approval
/// creates or activates the GuardianLink. Nothing here grants access.
model GuardianLinkRequest {
  id                String                @id @default(cuid())
  profileId         String
  profile           GuardianProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentId         String?
  admissionNumber   String?
  claimedRelationship String
  note              String?
  status            GuardianRequestStatus @default(PENDING)
  reviewedByUid     String?
  reviewedAt        DateTime?
  reviewNote        String?
  resultingLinkId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([profileId])
  @@map("guardian_link_requests")
}

/// An onboarding batch over existing contact cards. DRY_RUN writes nothing but
/// this report; APPLIED creates PENDING links only; ROLLED_BACK removes what an
/// applied batch created while it is still untouched.
model GuardianOnboardingBatch {
  id            String              @id @default(cuid())
  status        GuardianBatchStatus @default(DRY_RUN)
  scope         Json?               // e.g. { classId, academicYear }
  summary       Json?
  createdByUid  String
  createdAt     DateTime            @default(now())
  appliedAt     DateTime?
  appliedByUid  String?
  rolledBackAt  DateTime?
  rolledBackByUid String?

  items         GuardianOnboardingItem[]

  @@index([status, createdAt])
  @@map("guardian_onboarding_batches")
}

model GuardianOnboardingItem {
  id               String                  @id @default(cuid())
  batchId          String
  batch            GuardianOnboardingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  directoryEntryId String
  studentId        String
  action           GuardianBatchItemAction
  reason           String?
  flags            Json?
  /// Filled when applied, so a rollback removes exactly what this batch made.
  createdProfileId String?
  createdLinkId    String?
  createdContactIds String[]               @default([])

  @@index([batchId, action])
  @@index([directoryEntryId])
  @@map("guardian_onboarding_items")
}

/// What a guardian opened or was refused. Child-safeguarding evidence: who
/// looked at what, when. No PII beyond ids; written by the parent API.
model GuardianAccessLog {
  id         String           @id @default(cuid())
  profileId  String
  profile    GuardianProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkId     String?
  link       GuardianLink?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  studentId  String?
  module     String           // children | results | fees | attendance | notices | documents | profile
  outcome    String           // ALLOWED | DENIED
  reason     String?
  createdAt  DateTime         @default(now())

  @@index([profileId, createdAt])
  @@index([studentId, createdAt])
  @@map("guardian_access_logs")
}
