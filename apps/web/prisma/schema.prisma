  sentryAlertId   String    @unique
  name            String
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  raw             Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
model SentryRollupStat {
  id          String    @id @default(cuid())
  metricKey   String    @unique   // e.g. "crash_free_sessions:7d", "apdex:24h", "releases_count:30d", "crash_free_users:7d"
  value       Float
  windowLabel String              // "7d", "24h", "30d" — for display only
  syncedAt    DateTime  @default(now())
}

model MonitoringSyncState {
  syncType     String    @id   // "issues" | "alerts" | "rollup"
  lastSyncedAt DateTime
  lastError    String?
}

// ─── Vercel-native platform monitoring ──────────────────────────────────
model VercelDeploymentCache {
  id              String    @id @default(cuid())
  deploymentId    String    @unique   // Vercel's own deployment "uid"
  state           String              // BUILDING | ERROR | INITIALIZING | QUEUED | READY | CANCELED | BLOCKED
  target          String?             // "production" | "staging" | null (preview)
  url             String?
  errorMessage    String?
  createdAtVercel DateTime            // Vercel's own deployment creation timestamp
  readyAtVercel   DateTime?
  syncedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([state])
}
model VercelRuntimeLogCache {
  id                 String    @id @default(cuid())
  rowId              String    @unique
  level              String              // debug | error | fatal | info | trace | warning
  message            String    @db.Text
  source             String?             // serverless | edge-function | edge-middleware | request | delimiter
  deploymentId       String?
  domain             String?
  requestMethod      String?
  requestPath        String?
  responseStatusCode Int?
  timestamp          DateTime
  createdAt          DateTime  @default(now())

  @@index([level, timestamp])
}

model VercelRollupStat {
  id          String    @id @default(cuid())
  metricKey   String    @unique   // e.g. "pageviews:24h", "visitors:24h"
  value       Float
  windowLabel String
  syncedAt    DateTime  @default(now())
}

model VercelAlertEvent {
  id           String    @id @default(cuid())
