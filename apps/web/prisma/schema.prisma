  annualAverage  Decimal  @db.Decimal(5,2)
  finalGrade     String
  annualPosition Int?
  passStatus     Boolean
  promoted       Boolean  @default(false)
  nextClassId    String?
  createdAt      DateTime @default(now())

  @@unique([studentId, academicYear])
  @@map("annual_results")
}

model ManebRecord {
  id            String        @id @default(cuid())
  studentId     String
  examType      ManebExamType
  candidateNo   String        @unique
  centerNo      String
  centerName    String
  academicYear  String
  subjectGrades Json
  overallGrade  String?       // GR-2: JCE = 'PASS'/'FAIL'/'Incomplete'; MSCE = 'MSCE Awarded — Option A/B'/'MSCE Not Awarded'/'Incomplete'
  aggregatePoints Int?          // GR-2: MSCE only — sum of best-6 PERFORMED subjects' points (English incl. only if naturally in the best 6). Always null for JCE — JCE has no numeric aggregate.
  status        ManebStatus   @default(REGISTERED)
  universityPlacement UniversityPlacement?   // R18 — placement derived from this MSCE record
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId])
  @@map("maneb_records")
}

enum ManebExamType {
    JCE 
    MSCE
 }
enum ManebStatus   {
    REGISTERED
    SITTING
    RESULTS_RECEIVED 
    CERTIFIED
 }

// ─── HR MODULE ────────────────────────────────────────────
model GalleryPhoto {
