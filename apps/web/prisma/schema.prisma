// ─── ANNOUNCEMENT ─────────────────────────────────────────
// Minimal shape — makes public.ts's GET /public/announcements and
// calendar.ts's calendar-feed query (both pre-existing, both referencing
// prisma.announcement with no Prisma model behind it at all — a confirmed
// build-breaking defect, since neither could have typechecked against the
// generated Prisma client) compile and function correctly. A full
// Announcements domain (create/publish workflow, role/class targeting,
// approval, S/schemas/student.ts's AnnouncementSchema reconciliation) is
// its own dedicated roadmap phase and is not built out here — this model
// only covers the two read-only call sites that already exist.
model Announcement {
  id             String    @id @default(cuid())
  title          String
  body           String
  category       String?
  published      Boolean   @default(false)
  targetAudience String    @default("ALL")
  eventDate      DateTime?
  createdAt      DateTime  @default(now())

  @@index([published])
  @@index([eventDate])
  @@map("announcements")
}

// ─── CALENDAR EVENT (R13) ─────────────────────────────────
// Generic, manually-created calendar events — distinct from the other
// eight aggregated sources GET /calendar/events already computes
// (holidays, terms, exams, lab bookings, leave, timetable,
// announcements, assignments), none of which are rows in this table.
// No such model existed anywhere despite calendar.createEvent/editEvent/
// deleteEvent/manageAcademicCalendar being formally granted to seven and
// two roles respectively per the permission matrix — a genuine,
// previously-unimplementable capability, not a defect in existing code.
model CalendarEvent {
  id            String   @id @default(cuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  category      String   // CalendarEventCategory union — see @shared/types/calendar
  createdByUid  String   // Firebase UID — plain string, no @relation (see sms-erp-schema Rule 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
  @@index([createdByUid])
  @@map("calendar_events")
}

// ─── UNIVERSITY PLACEMENT (R18 — advisory placement module) ──────────
// Advisory-only: computes MSCE-eligibility against the git-versioned
// @shared/constants/universities catalogue, records self-reported and
// staff-verified placement outcomes, and feeds cohort analytics. It NEVER
// grades — MSCE results arrive already-graded via ManebRecord. A placement
// is keyed to exactly one certified MSCE ManebRecord (manebRecordId @unique).
// Catalogue references (placedUniversityId/placedProgrammeId, and the same
// pair on PlacementChoice) are plain string keys into the constants file, not
// DB foreign keys — the catalogue is not a table. Free-text fields carry
// universities/programmes outside the curated catalogue (private/foreign).
// Actor UIDs are Firebase UIDs — plain strings, no @relation (sms-erp-schema
// Rule 2), matching the CalendarEvent.createdByUid convention above.
enum PlacementStatus {
  NOT_STARTED             // no eligibility computed yet
  ELIGIBILITY_COMPUTED    // recommendations generated, no choices recorded
  CHOICES_RECORDED        // student/staff recorded ranked choices
  PLACED                  // an outcome was recorded (self-reported or staff)
  CONFIRMED               // student confirmed they are taking the place
  DECLINED                // student declined the place
  NOT_PLACED              // cycle closed with no placement
}

model UniversityPlacement {
  id                   String          @id @default(cuid())
  studentId            String
  student              Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // The certified MSCE record this placement is derived from. Unique: one
  // placement per MSCE sitting. Nullable relation is not needed — a placement
  // always originates from a specific MSCE record.
  manebRecordId        String          @unique
  manebRecord          ManebRecord     @relation(fields: [manebRecordId], references: [id], onDelete: Cascade)
  status               PlacementStatus @default(NOT_STARTED)
  eligibilityComputedAt DateTime?
  // Catalogue keys (into @shared/constants/universities) OR free-text — the
  // service layer enforces that exactly one of the two pairs is populated for
  // a recorded outcome.
  placedUniversityId   String?
  placedProgrammeId    String?
  placedUniversityName String?         // free-text (private/foreign, or off-catalogue)
  placedProgrammeName  String?         // free-text
  isVerified           Boolean         @default(false)
  recordedByUid        String?         // Firebase UID of student (self-report) or staff
  verifiedByUid        String?         // Firebase UID of high_rank verifier
  verifiedAt           DateTime?
  notes                String?
  choices              PlacementChoice[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([studentId, status])
  @@map("university_placements")
}

model PlacementChoice {
  id                    String              @id @default(cuid())
  placementId           String
  placement             UniversityPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  rank                  Int                 // 1 = first choice
  // Catalogue keys OR free-text (private/foreign). Eligibility is computed for
  // catalogue programmes; free-text choices carry no computed eligibility.
  universityId          String?
  programmeId           String?
  universityNameFreeText String?
  programmeNameFreeText  String?
  isEligible            Boolean             @default(false)
  score                 Float?              // sort key only; never a pass/fail cutoff
  missingSubjects       String[]            // subjects that blocked eligibility, if any
  createdAt             DateTime            @default(now())

  @@unique([placementId, rank])
  @@map("placement_choices")
}
