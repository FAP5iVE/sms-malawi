model StaffProfile {
  id                  String         @id @default(cuid())
  uid                 String         @unique   // Firebase Auth UID
  employeeNo          String         @unique
  firstName           String
  lastName            String
  sex                 Sex?           // optional: drives the dashboard profile picture; null until HR records it
  email               String         @unique
  phone               String?
  role                StaffRole      // R11: was an unenforced String documented as "matches UserRole values" — now a real enum
  department          String   // legacy free-text — retained; see departmentRef for the structured link
  departmentId        String?  // R22 — structured, nullable, additive
  jobTitle            String
  employmentType      EmploymentType @default(FULL_TIME)
  status              StaffStatus    @default(ACTIVE)
  dateJoined          DateTime
  contractExpiry      DateTime?
  // ── Identity (additive, nullable) — HR-only; see hr.viewStaffSensitive ───
  dateOfBirth         DateTime?
  nationality         String?        @default("Malawian")
  homeDistrict        String?
  nrbNumber           String?        @unique   // NRB national ID number
  tpin                String?                  // MRA taxpayer identification number
  nextOfKinName       String?
  nextOfKinPhone      String?
  nextOfKinRelation   String?
  // ── Teaching, licensing and qualifications (additive, nullable / defaulted) ──
  // isTeaching is explicit because StaffRole does not say who must hold a TCM
