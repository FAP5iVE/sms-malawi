generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── STUDENTS ────────────────────────────────────────────
model Student {
  id               String   @id @default(cuid())
  registrationNo   String   @unique          // auto-generated e.g. SMS-2025-0001
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime
  sex              Sex
  nationality      String   @default("Malawian")
  district         String
  village          String?
  address          String?
  phone            String?
  email            String?
  guardianName     String
  guardianPhone    String
  guardianRelation String
  // ── Demographics (additive, all nullable or defaulted) ───────────────────
  // ── Welfare (sensitive child data) — see student.viewWelfare / editWelfare.
  // NEVER an input to the risk score (that would label children) and never in
  // the student detail payload: it is served only by the welfare endpoints.
  orphanStatus            OrphanStatus  @default(UNKNOWN)   // UNKNOWN, not NONE: existing students are never wrongly recorded as having two living parents
  isVulnerable            Boolean       @default(false)
  vulnerabilityNote       String?
  vulnerabilityReviewedAt DateTime?
  medicalAlert            String?
  // ── Exit (set when status moves to ARCHIVED; ARCHIVED stays the terminal status) ──
  exitReason              ExitReason?
  exitDate                DateTime?
  exitNote                String?           // free text, sensitive: served only with student.viewWelfare
  nrbNumber            String?        @unique   // National Registration Bureau / birth-certificate no. Nullable: many children are unregistered
  traditionalAuthority String?                  // free text for now; a per-district lookup can follow
  religion             String?
  homeLanguage         String?
  residenceType        ResidenceType?
  travelMinutes        Int?                     // one-way travel time to school, minutes
  admissionType        AdmissionType  @default(NEW_INTAKE)
  previousSchool       String?
  reasonForTransfer    String?
  photoKey         String?
  firebaseUid      String?   @unique   // Firebase Auth UID — set on student account creation
  status           StudentStatus @default(ACTIVE)
  classId          String?
  class            Class?        @relation(fields: [classId], references: [id])
  transcriptKey    String?    // Appwrite file ID for latest transcript
  borrowings       Borrowing[]
  invoices         Invoice[]
  credits          StudentCredit[]
  feeCommitments   StudentFeeCommitment[]
  attendanceRecords Attendance[]
  universityPlacements UniversityPlacement[]   // R18 — advisory university placements
  guardians        StudentGuardian[]   // Student.guardianName/Phone/Relation stay as the denormalised PRIMARY guardian
  guardianLinks    GuardianLink[]      // Guardian PORTAL access grants (see GuardianLink). Not the contact cards above.
  supportNeeds     StudentSupportNeed[]
  yearOutcomes     StudentYearOutcome[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([classId])
  @@index([status])
  @@index([firebaseUid])
  @@map("students")
}

/// One row per student per academic year, written when a promotion run is
/// committed (same transaction). Source for "times repeated", repetition rate by
/// form and dropout analysis. GRADUATED is reserved for the MANEB-results step.
model StudentYearOutcome {
  id             String      @id @default(cuid())
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   String
  form           Int
  outcome        YearOutcome
  promotionRunId String?
  createdAt      DateTime    @default(now())

  @@unique([studentId, academicYear])
  @@map("student_year_outcomes")
}

/// Special / learning-support needs. Sensitive: read with student.viewWelfare,
/// written with student.editWelfare, every change audited.
model StudentSupportNeed {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type            SupportNeedType
  accommodation   String?         // e.g. front-row seating, large print
  assistiveDevice String?
  identifiedAt    DateTime?
  recordedByUid   String
  createdAt       DateTime        @default(now())

  @@index([studentId])
  @@map("student_support_needs")
}

/// One row per guardian. Rules enforced in studentService (not the DB): exactly
/// one isPrimary per student, and at least one isEmergencyContact. The primary
/// row is mirrored into Student.guardianName/guardianPhone/guardianRelation in
/// the same transaction, because invoices, SMS, Algolia and the forms read those
/// legacy columns.
model StudentGuardian {
  id                 String   @id @default(cuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName           String
  relation           String   // values from GUARDIAN_RELATIONSHIPS
  phone              String
  altPhone           String?
  email              String?
  address            String?
  nrbNumber          String?
  isPrimary          Boolean  @default(false)
  isFeePayer         Boolean  @default(false)
  isEmergencyContact Boolean  @default(false)
  livesWithStudent   Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  portalLinks        GuardianLink[]   // at most one portal proposal per card (provenance only, never access)

  @@index([studentId])
  @@map("student_guardians")
}

enum ExitReason {
  TRANSFERRED_OUT
  DROPPED_OUT
  DISMISSED
  DECEASED
  WITHDRAWN
  OTHER
}

enum YearOutcome {
  PROMOTED
  REPEATED
  GRADUATED
  AWAITING_MANEB
}

enum OrphanStatus {
  UNKNOWN
  NONE
  FATHER_DECEASED
  MOTHER_DECEASED
  BOTH_DECEASED
}

enum SupportNeedType {
  LOW_VISION
  BLIND
  HARD_OF_HEARING
  DEAF
  PHYSICAL_IMPAIRMENT
  LEARNING_DIFFICULTY
  ALBINISM
  OTHER
}

enum ResidenceType {
  DAY_HOME
  BOARDER
  LODGING
  WITH_RELATIVE
}

enum AdmissionType {
  NEW_INTAKE
  TRANSFER_IN
  RETURNEE
}

enum StudentStatus {
  ACTIVE
  AWAITING_MANEB_RESULTS
  GRADUATED
  ARCHIVED
}

enum Sex {
  MALE
  FEMALE
}

// ─── CLASSES ─────────────────────────────────────────────
model Class {
  id          String    @id @default(cuid())
  name        String                       // "Form 1A", "Form 2B", etc.
  form        Int                          // 1, 2, 3, or 4
  stream      String?                      // "A", "B", "Science", "Arts"
  teacherId   String?                      // class teacher Firebase UID
  room        String?
  status      ClassStatus @default(ACTIVE)
  academicYear String                      // "2025/2026"
  // [MAINT 2026-09-16 — Class Subject Presets] Timestamp of the first time
  // this class's ClassSubjectPreset rows were ever set. Anchors the 5-day
  // edit window (classService's SUBJECT_PRESET_LOCK_WINDOW_DAYS): once now()
  // passes subjectsSetAt + 5 days, the preset subject list is locked for
  // the remainder of this Class row's academicYear (Class rows are already
  // one-per-year — see promotionService's nextClassId handoff — so "locked
  // for the rest of the academic year" and "locked for this Class row" are
  // the same statement). Null means presets have never been set yet, which
  // is also the signal setClassSubjectPresets()/assertSubjectOfferedByClass()
  // use to distinguish "first-time setup" (unrestricted) from "editing
  // within the window" (diff + in-use guard) from "locked" (rejected).
  subjectsSetAt DateTime?
  students    Student[]
  assignments Assignment[]
  labBookings LabBooking[]
  timetable   TimetableSlot[]
  exams       Exam[]
  subjectAssignments ClassSubjectAssignment[]
  subjectPresets     ClassSubjectPreset[]
  attendanceRecords Attendance[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([form])
  @@index([academicYear])
  @@index([status])
  @@map("classes")
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

// ─── ASSIGNMENTS ─────────────────────────────────────────
model Assignment {
  id          String    @id @default(cuid())
  title       String
  // [2026-10-27 Assignment workflow] `description` now holds the task CONTENT
  // as sanitised rich-text HTML (formatting, images, math formulae); older rows
  // hold plain text, which renders fine as a single paragraph.
  description String?
  requirements String?                    // rich-text HTML: what the student must hand in / how it is judged
  subject     String
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  // Stored as the END of the due day in school time (Africa/Blantyre, UTC+2).
  // Legacy rows hold midnight UTC of the due day; deadlineFor() in
  // packages/shared/utils/assignment.ts treats both as "due at the end of that
  // calendar day" (no historical row is rewritten).
  dueDate     DateTime
  createdByUid String                     // teacher Firebase UID
  // Optional, per-assignment choice. Session marks only - they are NEVER fed
  // into exam results or continuous assessment; they exist so the teacher can
  // see whether students are keeping up with the session.
  marksEnabled Boolean   @default(false)
  maxMarks     Int?
  submissions AssignmentSubmission[]
  attachments AssignmentAttachment[]
  views       AssignmentView[]
  createdAt   DateTime  @default(now())
  // Also the edit "version": PATCH may send the updatedAt it loaded and gets a 409
  // instead of silently overwriting a newer change.
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([classId])
  @@index([classId, dueDate])   // class listing ordered by deadline
  @@map("assignments")
}

// Files and pictures the teacher attaches to an assignment. kind = 'IMAGE'
// (public-read prefix, shown as a thumbnail) or 'FILE' (private, downloaded
// through the authenticated /api/files proxy).
model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  // A storage object belongs to AT MOST ONE attachment: a client can never claim a
  // file another record already uses (and removing one record can never delete a
  // file that another still references).
  fileKey      String     @unique
  fileName     String     // from the STORED object's metadata, never from the client
  mimeType     String     // idem
  sizeBytes    Int        @default(0)   // idem
  kind         String     @default("FILE")   // derived from the key prefix: IMAGE | FILE
  uploadedByUid String?   // the teacher who attached it (ownership / audit)
  createdAt    DateTime   @default(now())

  @@index([assignmentId])
  @@map("assignment_attachments")
}

// One row per (assignment, student): when the student first/last opened it.
// Written when a student opens the assignment; read by the teacher's progress
// view ("who has seen it").
model AssignmentView {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  firstViewedAt DateTime   @default(now())
  lastViewedAt  DateTime   @default(now())
  viewCount     Int        @default(1)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@map("assignment_views")
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  fileKey      String?   @unique   // Appwrite object key for uploaded file (single-bucket, FILE_PREFIX.ASSIGNMENT_SUBMISSION-namespaced — see lib/storage.ts). Unique: one stored file backs at most one hand-in (NULLs are distinct, so note-only/MISSING rows are unaffected).
  fileName     String?   // from the stored object's metadata, for display
  note         String?   // optional message from the student
  // For SUBMITTED / LATE: when the work came in (a student's own submission =
  // the moment they sent it; a teacher-recorded one = the "submitted on" date
  // the teacher entered). For MISSING (explicitly marked not submitted) the
  // value is just the time the row was written and must be ignored.
  submittedAt  DateTime  @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  recordedByUid String?  // set when a TEACHER recorded the submission on the student's behalf
  marks        Float?    // session marks - only when Assignment.marksEnabled
  feedback     String?
  markedAt     DateTime?
  markedByUid  String?
  // Edit "version" for the teacher's marking dialog (409 on a stale save).
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  MISSING
}

// ─── ATTENDANCE  ─────────────────────
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  date      DateTime                    // day-granularity; time component always midnight
  status    AttendanceStatus
  markedBy  String                      // Firebase UID of the teacher who marked it —
                                         // application-level validated (Class.teacherId
                                         // match), no DB-level FK across the
                                         // Firebase-UID/Postgres boundary is possible
  createdAt DateTime @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ─── LAB BOOKINGS ─────────────────────────────────────────
model LabBooking {
  id           String    @id @default(cuid())
  classId      String
  class        Class     @relation(fields: [classId], references: [id])
  bookedByUid  String    // teacher Firebase UID
  labName      String    @default("Science Lab")
  date         DateTime
  periodStart  String    // "08:00"
  periodEnd    String    // "09:00"
  purpose      String?
  createdAt    DateTime  @default(now())

  @@index([date])
  @@map("lab_bookings")
}

// ─── APPLICATIONS ────────────────────────────────────────
model Application {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime
  sex              Sex
  nationality      String
  district         String
  village          String?
  traditionalAuthority String?
  religion         String?
  homeLanguage     String?
  // ── Carried onto the Student when the application is converted ───────────
  nrbNumber        String?                  // optional; NOT unique here (the Student column is)
  residenceType    ResidenceType?
  travelMinutes    Int?
  admissionType    AdmissionType?           // null = derived from applyingForForm at conversion
  // Welfare / health / special needs: sensitive child data. Served to the UI only
  // for roles holding student.viewWelfare (the applications routes strip these
  // fields otherwise) and copied to the Student + student_support_needs on admission.
  orphanStatus     OrphanStatus      @default(UNKNOWN)
  isVulnerable     Boolean           @default(false)
  vulnerabilityNote String?
  medicalAlert     String?
  supportNeeds     Json?                    // [{ type, accommodation?, assistiveDevice? }]
  guardianName     String
  guardianPhone    String
  email            String?
  phone            String?
  address          String?
  previousSchool   String?
  reasonForTransfer String?
  academicYear     String?
  guardianEmail    String?
  guardianAddress  String?
  guardianRelation String
  applyingForForm  Int               // 1–4
  status           ApplicationStatus @default(PENDING)
  reviewedByUid    String?
  reviewedAt       DateTime?
  notes            String?
  convertedStudentId String?         // set when converted to Student record
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  AWAITING_ADMISSION
  ADMITTED
}

// ─── TIMETABLE ───────────────────────────────────────────
model TimetableSlot {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  day         Weekday
  periodStart String    // "07:30"
  periodEnd   String    // "08:30"
  subject     String
  teacherUid  String
  room        String?
  type        TimetableType @default(REGULAR)
  academicYear String
  term        Int       // 1, 2, or 3
  approvedAt  DateTime?
  approvedByUid String?

  @@index([classId, day])
  @@index([academicYear, term])
  @@map("timetable_slots")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
enum TimetableType {
  REGULAR
  EXAM
  MANEB
  LAB
}

// ─── CLASS SUBJECT ASSIGNMENT ─────────────────────────────
model ClassSubjectAssignment {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String
  teacherUid   String
  academicYear String
  createdByUid String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([classId, subject, academicYear])
  @@index([teacherUid, academicYear])
  @@index([classId, academicYear])
  @@map("class_subject_assignments")
}


// ─── CLASS SUBJECT PRESET ─────────────────────────────────
// [NEW MODEL 2026-09-16 — Class Subject Presets] The set of subjects a
// class is offered — set once by admin/high_rank/lower_rank (see
// PERMISSIONS_MAP's class.manageSubjectPresets), editable for 5 days from
// the first time they're set (Class.subjectsSetAt), then locked for the
// rest of that Class row's academicYear (Class rows are already one per
// academic year — see Class.subjectsSetAt's own comment). This is
// deliberately a *separate* concept from ClassSubjectAssignment (which
// pairs a specific teacher to a subject *within* this preset list) —
// conflating "what subjects does this class offer" with "who teaches
// them" was the pre-existing gap this model closes. Every subject-bearing
// write this phase touches (TimetableSlot.subject via
// classService.createTimetableSlot, ClassSubjectAssignment.subject via
// classService.createSubjectAssignment, Exam.subject via
// examService.createExam/updateExam) is validated against this table
// through the single shared classService.assertSubjectOfferedByClass()
// helper — one canonical gate, not a duplicate check per call site.
model ClassSubjectPreset {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String
  createdByUid String
  createdAt    DateTime @default(now())

  @@unique([classId, subject])
  @@index([classId])
  @@map("class_subject_presets")
}

// ─── AUDIT LOG ───────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  action     String                         // "student.create", "student.archive"
  entityType String                         // "Student", "Application"
  entityId   String
  actorUid   String
  actorRole  String
  metadata   Json?                          // before/after values
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUid])
  @@map("audit_logs")
}

// ─── USER SESSIONS ────────────────────────────────────────
// [NEW — Sessions tab, Reports > Admin] Backs the "who's logged in right
// now" admin view (userMgmt.viewActiveSessions / userMgmt.terminateSession
// — both permissions already existed in permissions.ts with zero callers
// until now). One open (loggedOutAt IS NULL) row per uid at a time:
// Firebase Admin's revokeRefreshTokens(uid) has no per-device granularity
// — it revokes every refresh token for that uid at once — so tracking
// per-device rows separately would let the UI promise a per-device force
// logout it can't actually deliver. A fresh login-success closes any
// still-open row for the same uid (endReason: 'new_login') before opening
// a new one, so at most one row per uid is ever "open".
// lastSeenAt is bumped by a periodic client heartbeat (POST
// /auth/heartbeat, ~60s interval — see useSessionHeartbeat.ts) rather than
// on every API call, so "currently active" is computed as
// loggedOutAt IS NULL AND lastSeenAt within a short grace window of now,
// not merely "never logged out" (a browser closed without a clean logout
// would otherwise look active forever).
model UserSession {
  id           String    @id @default(cuid())
  uid          String                            // Firebase Auth UID
  role         String                             // role snapshot at login time
  loginAt      DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())          // bumped by heartbeat
  loggedOutAt  DateTime?                          // null while the session is open
  endReason    String?                            // 'logout' | 'forced' | 'new_login'
  forcedByUid  String?                            // admin uid, when endReason = 'forced'
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([uid])
  @@index([lastSeenAt])
  @@index([uid, loggedOutAt])
  @@map("user_sessions")
}

// ─── FEE STRUCTURE ───────────────────────────────────────
// [SCHEMA EXTENSION 2026-09-05] category/code/mandatory/schedule/description added
// so the Fee Catalog (Settings) can show real accounting metadata (category badge,
// mandatory-vs-optional, billing schedule) instead of a bare name+amount row.
// `isActive` keeps its existing meaning and now doubles as the catalog's
// Active/Archived state: archiving a fee hides it from new invoice line-item
// pickers while leaving every existing invoice/line-item untouched (Ledger
// Preservation Policy) -- never hard-delete a FeeStructure row that has any
// InvoiceLineItem referencing it.
model FeeStructure {
  id           String       @id @default(cuid())
  name         String                            // "Tuition", "Boarding", "Exam", "Uniform", "Library", "Transport"
  code         String                            // catalog code, e.g. "TUI-01" -- stable identifier, unique per academic year
  category     FeeCategory  @default(OTHER)
  amount       Decimal      @db.Decimal(12, 2)   // MWK amount -- the standard rate for this catalog item
  mandatory    Boolean      @default(true)        // false = optional / enrolled add-on (Transport, Boarding, Uniform, ...)
  schedule     FeeSchedule  @default(PER_TERM)
  description  String?
  classId      String?                           // null = applies to all classes
  academicYear String
  term         Int?                              // null = applies to all terms
  isActive     Boolean      @default(true)        // false = archived (see header note above)
  commitments  StudentFeeCommitment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([academicYear, code])
  @@index([academicYear, classId])
  @@map("fee_structures")
}

enum FeeCategory {
  TUITION
  TRANSPORT
  UNIFORM
  BOARDING
  LEVY
  ACTIVITY
  OTHER
}

enum FeeSchedule {
  PER_TERM
  ANNUAL
  ONE_TIME
}

// [NEW MODEL 2026-09-05] A student's opt-in to an OPTIONAL fee type
// (Transport, Boarding, Uniform, ...) for a given academic year -- this is
// the "Enrolled Add-on" state shown on the Finance Fee Structure
// workstation and read by BulkInvoiceGenerator's "Include Enrolled Optional
// Services" step. Mandatory fees never need a commitment row -- they apply
// to every student in the relevant class/term automatically via
// FeeStructure.mandatory. A WAIVED commitment is kept (not deleted) so the
// bursar's decision to stop billing a specific add-on for a specific
// student is itself part of the audit trail, not silently erased.
model StudentFeeCommitment {
  id            String               @id @default(cuid())
  studentId     String
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure  FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  academicYear  String
  status        FeeCommitmentStatus  @default(COMMITTED)
  notes         String?
  createdByUid  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([studentId, feeStructureId, academicYear])
  @@index([studentId])
  @@index([academicYear])
  @@map("student_fee_commitments")
}

enum FeeCommitmentStatus {
  COMMITTED
  WAIVED
}

// ─── STUDENT INVOICE (per term per student) ───────────────
model Invoice {
  id              String          @id @default(cuid())
  invoiceNumber   String          @unique   // sequential, human-readable -- e.g. "INV-2026-0042" (see invoiceNumberService.ts)
  studentId       String
  academicYear    String
  term            Int
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @db.Decimal(12, 2) @default(0)
  latePenalty     Decimal         @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal         @db.Decimal(12, 2)
  paidAmount      Decimal         @db.Decimal(12, 2) @default(0)
  balance         Decimal         @db.Decimal(12, 2)   // totalAmount - paidAmount
  status          InvoiceStatus   @default(UNPAID)
  dueDate         DateTime
  scholarshipId   String?
  student         Student       @relation(fields: [studentId], references: [id])
  payments        Payment[]
  notes           InvoiceNote[]
  lineItems       InvoiceLineItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([studentId, academicYear, term])   // one invoice per student per term
  @@index([studentId])
  @@index([status])
  @@index([academicYear, term])
  @@map("invoices")
}

enum InvoiceStatus {
    UNPAID
    PARTIAL
    PAID 
    OVERDUE
     }


model InvoiceLineItem {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?  // nullable: the source fee structure, for reference only
  feeName        String
  amount         Decimal  @db.Decimal(12, 2)   // owed for this fee type
  paidAmount     Decimal  @db.Decimal(12, 2) @default(0)
  balance        Decimal  @db.Decimal(12, 2)   // amount - paidAmount
  allocations    PaymentAllocation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}


model PaymentAllocation {
  id         String          @id @default(cuid())
  paymentId  String
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
