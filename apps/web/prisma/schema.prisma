generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── STUDENTS ────────────────────────────────────────────
model Student {
  id               String   @id @default(cuid())
  registrationNo   String   @unique          // auto-generated e.g. SMS-2025-0001
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime
  sex              Sex
  nationality      String   @default("Malawian")
  district         String
  village          String?
  address          String?
  phone            String?
  email            String?
  guardianName     String
  guardianPhone    String
  guardianRelation String
  photoKey         String?
  firebaseUid      String?   @unique   // Firebase Auth UID — set on student account creation
  status           StudentStatus @default(ACTIVE)
  classId          String?
  class            Class?        @relation(fields: [classId], references: [id])
  transcriptKey    String?    // Appwrite file ID for latest transcript
  borrowings       Borrowing[]
  invoices         Invoice[]
  credits          StudentCredit[]
  feeCommitments   StudentFeeCommitment[]
  attendanceRecords Attendance[]
  universityPlacements UniversityPlacement[]   // R18 — advisory university placements
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([classId])
  @@index([status])
  @@index([firebaseUid])
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  AWAITING_MANEB_RESULTS
  GRADUATED
  ARCHIVED
}

enum Sex {
  MALE
  FEMALE
}

// ─── CLASSES ─────────────────────────────────────────────
model Class {
  id          String    @id @default(cuid())
  name        String                       // "Form 1A", "Form 2B", etc.
  form        Int                          // 1, 2, 3, or 4
  stream      String?                      // "A", "B", "Science", "Arts"
  teacherId   String?                      // class teacher Firebase UID
  room        String?
  status      ClassStatus @default(ACTIVE)
  academicYear String                      // "2025/2026"
  // [MAINT 2026-09-16 — Class Subject Presets] Timestamp of the first time
  // this class's ClassSubjectPreset rows were ever set. Anchors the 5-day
  // edit window (classService's SUBJECT_PRESET_LOCK_WINDOW_DAYS): once now()
  // passes subjectsSetAt + 5 days, the preset subject list is locked for
  // the remainder of this Class row's academicYear (Class rows are already
  // one-per-year — see promotionService's nextClassId handoff — so "locked
  // for the rest of the academic year" and "locked for this Class row" are
  // the same statement). Null means presets have never been set yet, which
  // is also the signal setClassSubjectPresets()/assertSubjectOfferedByClass()
  // use to distinguish "first-time setup" (unrestricted) from "editing
  // within the window" (diff + in-use guard) from "locked" (rejected).
  subjectsSetAt DateTime?
  students    Student[]
  assignments Assignment[]
  labBookings LabBooking[]
  timetable   TimetableSlot[]
  exams       Exam[]
  subjectAssignments ClassSubjectAssignment[]
  subjectPresets     ClassSubjectPreset[]
  attendanceRecords Attendance[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([form])
  @@index([academicYear])
  @@index([status])
  @@map("classes")
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

// ─── ASSIGNMENTS ─────────────────────────────────────────
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  subject     String
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  dueDate     DateTime
  createdByUid String                     // teacher Firebase UID
  submissions AssignmentSubmission[]
  createdAt   DateTime  @default(now())

  @@index([classId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  fileKey      String?   // Appwrite object key for uploaded file (single-bucket, FILE_PREFIX.ASSIGNMENT_SUBMISSION-namespaced — see lib/storage.ts)
  submittedAt  DateTime  @default(now())
  status       SubmissionStatus @default(SUBMITTED)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  MISSING
}

// ─── ATTENDANCE  ─────────────────────
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  date      DateTime                    // day-granularity; time component always midnight
  status    AttendanceStatus
  markedBy  String                      // Firebase UID of the teacher who marked it —
                                         // application-level validated (Class.teacherId
                                         // match), no DB-level FK across the
                                         // Firebase-UID/Postgres boundary is possible
  createdAt DateTime @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ─── LAB BOOKINGS ─────────────────────────────────────────
model LabBooking {
  id           String    @id @default(cuid())
  classId      String
  class        Class     @relation(fields: [classId], references: [id])
  bookedByUid  String    // teacher Firebase UID
  labName      String    @default("Science Lab")
  date         DateTime
  periodStart  String    // "08:00"
  periodEnd    String    // "09:00"
  purpose      String?
  createdAt    DateTime  @default(now())

  @@index([date])
  @@map("lab_bookings")
}

// ─── APPLICATIONS ────────────────────────────────────────
model Application {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime
  sex              Sex
  nationality      String
  district         String
  village          String?
  guardianName     String
  guardianPhone    String
  email            String?
  phone            String?
  address          String?
  previousSchool   String?
  reasonForTransfer String?
  academicYear     String?
  guardianEmail    String?
  guardianAddress  String?
  guardianRelation String
  applyingForForm  Int               // 1–4
  status           ApplicationStatus @default(PENDING)
  reviewedByUid    String?
  reviewedAt       DateTime?
  notes            String?
  convertedStudentId String?         // set when converted to Student record
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  AWAITING_ADMISSION
  ADMITTED
}

// ─── TIMETABLE ───────────────────────────────────────────
model TimetableSlot {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  day         Weekday
  periodStart String    // "07:30"
  periodEnd   String    // "08:30"
  subject     String
  teacherUid  String
  room        String?
  type        TimetableType @default(REGULAR)
  academicYear String
  term        Int       // 1, 2, or 3
  approvedAt  DateTime?
  approvedByUid String?

  @@index([classId, day])
  @@index([academicYear, term])
  @@map("timetable_slots")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
enum TimetableType {
  REGULAR
  EXAM
  MANEB
  LAB
}

// ─── CLASS SUBJECT ASSIGNMENT ─────────────────────────────
model ClassSubjectAssignment {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String
  teacherUid   String
  academicYear String
  createdByUid String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([classId, subject, academicYear])
  @@index([teacherUid, academicYear])
  @@index([classId, academicYear])
  @@map("class_subject_assignments")
}


// ─── CLASS SUBJECT PRESET ─────────────────────────────────
// [NEW MODEL 2026-09-16 — Class Subject Presets] The set of subjects a
// class is offered — set once by admin/high_rank/lower_rank (see
// PERMISSIONS_MAP's class.manageSubjectPresets), editable for 5 days from
// the first time they're set (Class.subjectsSetAt), then locked for the
// rest of that Class row's academicYear (Class rows are already one per
// academic year — see Class.subjectsSetAt's own comment). This is
// deliberately a *separate* concept from ClassSubjectAssignment (which
// pairs a specific teacher to a subject *within* this preset list) —
// conflating "what subjects does this class offer" with "who teaches
// them" was the pre-existing gap this model closes. Every subject-bearing
// write this phase touches (TimetableSlot.subject via
// classService.createTimetableSlot, ClassSubjectAssignment.subject via
// classService.createSubjectAssignment, Exam.subject via
// examService.createExam/updateExam) is validated against this table
// through the single shared classService.assertSubjectOfferedByClass()
// helper — one canonical gate, not a duplicate check per call site.
model ClassSubjectPreset {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String
  createdByUid String
  createdAt    DateTime @default(now())

  @@unique([classId, subject])
  @@index([classId])
  @@map("class_subject_presets")
}

// ─── AUDIT LOG ───────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  action     String                         // "student.create", "student.archive"
  entityType String                         // "Student", "Application"
  entityId   String
  actorUid   String
  actorRole  String
  metadata   Json?                          // before/after values
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUid])
  @@map("audit_logs")
}

// ─── USER SESSIONS ────────────────────────────────────────
// [NEW — Sessions tab, Reports > Admin] Backs the "who's logged in right
// now" admin view (userMgmt.viewActiveSessions / userMgmt.terminateSession
// — both permissions already existed in permissions.ts with zero callers
// until now). One open (loggedOutAt IS NULL) row per uid at a time:
// Firebase Admin's revokeRefreshTokens(uid) has no per-device granularity
// — it revokes every refresh token for that uid at once — so tracking
// per-device rows separately would let the UI promise a per-device force
// logout it can't actually deliver. A fresh login-success closes any
// still-open row for the same uid (endReason: 'new_login') before opening
// a new one, so at most one row per uid is ever "open".
// lastSeenAt is bumped by a periodic client heartbeat (POST
// /auth/heartbeat, ~60s interval — see useSessionHeartbeat.ts) rather than
// on every API call, so "currently active" is computed as
// loggedOutAt IS NULL AND lastSeenAt within a short grace window of now,
// not merely "never logged out" (a browser closed without a clean logout
// would otherwise look active forever).
model UserSession {
  id           String    @id @default(cuid())
  uid          String                            // Firebase Auth UID
  role         String                             // role snapshot at login time
  loginAt      DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())          // bumped by heartbeat
  loggedOutAt  DateTime?                          // null while the session is open
  endReason    String?                            // 'logout' | 'forced' | 'new_login'
  forcedByUid  String?                            // admin uid, when endReason = 'forced'
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([uid])
  @@index([lastSeenAt])
  @@index([uid, loggedOutAt])
  @@map("user_sessions")
}

// ─── FEE STRUCTURE ───────────────────────────────────────
// [SCHEMA EXTENSION 2026-09-05] category/code/mandatory/schedule/description added
// so the Fee Catalog (Settings) can show real accounting metadata (category badge,
// mandatory-vs-optional, billing schedule) instead of a bare name+amount row.
// `isActive` keeps its existing meaning and now doubles as the catalog's
// Active/Archived state: archiving a fee hides it from new invoice line-item
// pickers while leaving every existing invoice/line-item untouched (Ledger
// Preservation Policy) -- never hard-delete a FeeStructure row that has any
// InvoiceLineItem referencing it.
model FeeStructure {
  id           String       @id @default(cuid())
  name         String                            // "Tuition", "Boarding", "Exam", "Uniform", "Library", "Transport"
  code         String                            // catalog code, e.g. "TUI-01" -- stable identifier, unique per academic year
  category     FeeCategory  @default(OTHER)
  amount       Decimal      @db.Decimal(12, 2)   // MWK amount -- the standard rate for this catalog item
  mandatory    Boolean      @default(true)        // false = optional / enrolled add-on (Transport, Boarding, Uniform, ...)
  schedule     FeeSchedule  @default(PER_TERM)
  description  String?
  classId      String?                           // null = applies to all classes
  academicYear String
  term         Int?                              // null = applies to all terms
  isActive     Boolean      @default(true)        // false = archived (see header note above)
  commitments  StudentFeeCommitment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([academicYear, code])
  @@index([academicYear, classId])
  @@map("fee_structures")
}

enum FeeCategory {
  TUITION
  TRANSPORT
  UNIFORM
  BOARDING
  LEVY
  ACTIVITY
  OTHER
}

enum FeeSchedule {
  PER_TERM
  ANNUAL
  ONE_TIME
}

// [NEW MODEL 2026-09-05] A student's opt-in to an OPTIONAL fee type
// (Transport, Boarding, Uniform, ...) for a given academic year -- this is
// the "Enrolled Add-on" state shown on the Finance Fee Structure
// workstation and read by BulkInvoiceGenerator's "Include Enrolled Optional
// Services" step. Mandatory fees never need a commitment row -- they apply
// to every student in the relevant class/term automatically via
// FeeStructure.mandatory. A WAIVED commitment is kept (not deleted) so the
// bursar's decision to stop billing a specific add-on for a specific
// student is itself part of the audit trail, not silently erased.
model StudentFeeCommitment {
  id            String               @id @default(cuid())
  studentId     String
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure  FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  academicYear  String
  status        FeeCommitmentStatus  @default(COMMITTED)
  notes         String?
  createdByUid  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([studentId, feeStructureId, academicYear])
  @@index([studentId])
  @@index([academicYear])
  @@map("student_fee_commitments")
}

enum FeeCommitmentStatus {
  COMMITTED
  WAIVED
}

// ─── STUDENT INVOICE (per term per student) ───────────────
model Invoice {
  id              String          @id @default(cuid())
  invoiceNumber   String          @unique   // sequential, human-readable -- e.g. "INV-2026-0042" (see invoiceNumberService.ts)
  studentId       String
  academicYear    String
  term            Int
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @db.Decimal(12, 2) @default(0)
  latePenalty     Decimal         @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal         @db.Decimal(12, 2)
  paidAmount      Decimal         @db.Decimal(12, 2) @default(0)
  balance         Decimal         @db.Decimal(12, 2)   // totalAmount - paidAmount
  status          InvoiceStatus   @default(UNPAID)
  dueDate         DateTime
  scholarshipId   String?
  student         Student       @relation(fields: [studentId], references: [id])
  payments        Payment[]
  notes           InvoiceNote[]
  lineItems       InvoiceLineItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([studentId, academicYear, term])   // one invoice per student per term
  @@index([studentId])
  @@index([status])
  @@index([academicYear, term])
  @@map("invoices")
}

enum InvoiceStatus {
    UNPAID
    PARTIAL
    PAID 
    OVERDUE
     }


model InvoiceLineItem {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?  // nullable: the source fee structure, for reference only
  feeName        String
  amount         Decimal  @db.Decimal(12, 2)   // owed for this fee type
  paidAmount     Decimal  @db.Decimal(12, 2) @default(0)
  balance        Decimal  @db.Decimal(12, 2)   // amount - paidAmount
  allocations    PaymentAllocation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}


model PaymentAllocation {
  id         String          @id @default(cuid())
  paymentId  String
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  lineItemId String
  lineItem   InvoiceLineItem @relation(fields: [lineItemId], references: [id])
  amount     Decimal         @db.Decimal(12, 2)
  createdAt  DateTime        @default(now())

  @@index([paymentId])
  @@index([lineItemId])
  @@map("payment_allocations")
}


model StudentCredit {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  amount          Decimal   @db.Decimal(12, 2)   // remaining unapplied balance
  originalAmount  Decimal   @db.Decimal(12, 2)   // what it started as, for the audit trail
  sourcePaymentId String?
  reason          String?
  createdAt       DateTime  @default(now())
  lastAppliedAt   DateTime?

  @@index([studentId])
  @@map("student_credits")
}

// ─── PAYMENT RECORD ──────────────────────────────────────
model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?       // bank ref, mobile money transaction ID
  receiptKey   String?       // R2 object key for generated PDF receipt
  recordedByUid String
  notes        String?
  paidAt       DateTime      @default(now())
  allocations  PaymentAllocation[]

  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
   CASH
   BANK_TRANSFER
   MOBILE_MONEY   // legacy value -- retained for existing records; new entries use AIRTEL_MONEY or TNM_MPAMBA
   CHEQUE
   AIRTEL_MONEY
   TNM_MPAMBA
   POS_CARD
   }

// ─── INVOICE NOTES (sticky notes on transactions) ────────
model InvoiceNote {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  body      String
  authorUid String
  createdAt DateTime @default(now())

  @@map("invoice_notes")
}

// ─── EXPENSE ─────────────────────────────────────────────
model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(12, 2)
  receiptKey   String?         // Appwrite file ID for scanned receipt
  academicYear String
  term         Int
  approvedByUid String?
  approvedAt   DateTime?
  // R22 note: the field-level spec (§27) proposed a richer target state machine
  // (DRAFT/SUBMITTED/PENDING_APPROVAL/RETURNED/APPROVED/VERIFIED/PAYABLE/PAID/REJECTED).
  // That is deliberately deferred — Artefacts 4/6/7/8 all say existing Expense
  // approval behaviour (Budget.spent update + journal posting) must continue
  // unchanged this phase. Only nullable procurement-traceability fields are added.
  status       ExpenseStatus   @default(PENDING)
  recordedByUid String
  incurredAt   DateTime
  createdAt    DateTime        @default(now())
  paidAt       DateTime?
  paidByUid    String?

  // R22 — procurement traceability (additive, all nullable; direct expenses stay valid)
  procurementSource      ProcurementSource?
  supplierId             String?
  purchaseOrderId        String?
  goodsReceiptId         String?
  supplierInvoiceNumber  String?
  verifiedByUid          String?
  verifiedAt             DateTime?

  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  commitments   BudgetCommitment[]

  @@index([academicYear, term])
  @@index([category])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("expenses")
}

enum ExpenseCategory { 
  SALARIES  
  UTILITIES  
  MAINTENANCE  
  PROCUREMENT  
  LIBRARY  
  TRANSPORT  
  MISCELLANEOUS 
  }

enum ExpenseStatus  { 
  PENDING  
  APPROVED  
  REJECTED 
  }

// ─── PAYROLL ─────────────────────────────────────────────
model PayrollRun {
  id             String          @id @default(cuid())
  month          Int             // 1–12
  year           Int
  status         PayrollStatus   @default(PROCESSING)
  totalGross     Decimal         @db.Decimal(12, 2)
  totalNet       Decimal         @db.Decimal(12, 2)
  runByUid       String
  submittedByUid String?         // R10 — set on submit-for-approval
  approvedByUid  String?         // R10 — set on approve
  approvedAt     DateTime?       // R10 — set on approve
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  payslips       Payslip[]

  @@unique([month, year])
  @@map("payroll_runs")
}

enum PayrollStatus {
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  LOCKED
  COMPLETED
  FAILED
  }

model Payslip {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id])
  staffUid      String
  staffName     String
  grossSalary   Decimal    @db.Decimal(12, 2)
  paye          Decimal    @db.Decimal(12, 2)  // income tax
  pension       Decimal    @db.Decimal(12, 2)
  loanDeduction Decimal    @db.Decimal(12, 2) @default(0)
  netSalary     Decimal    @db.Decimal(12, 2)
  payslipKey    String?    // R2 object key for PDF payslip
  createdAt     DateTime   @default(now())

  @@index([staffUid])
  @@index([payrollRunId])
  @@map("payslips")
}

// ─── SALARY STRUCTURE ────────────────────────────────────
model SalaryStructure {
  id           String   @id @default(cuid())
  staffUid     String   @unique
  baseSalary   Decimal  @db.Decimal(12, 2)
  allowances   Decimal  @db.Decimal(12, 2) @default(0)
  loanBalance  Decimal  @db.Decimal(12, 2) @default(0)
  monthlyLoanDeduction Decimal @db.Decimal(12, 2) @default(0)
  updatedAt    DateTime @updatedAt

  @@map("salary_structures")
}

model StaffAllowance {
  id           String   @id @default(cuid())
  staffUid     String
  type         String   // free text, e.g. "Housing", "Transport", "Responsibility", "Bonus"
  amount       Decimal  @db.Decimal(12, 2)
  recurring    Boolean  @default(true)
  paidMonth    Int?     // 1-12 — required when recurring = false, ignored when true
  paidYear     Int?
  notes        String?
  createdByUid String
  createdAt    DateTime @default(now())

  @@index([staffUid])
  @@index([staffUid, recurring])
  @@map("staff_allowances")
}

// ─── BUDGET ──────────────────────────────────────────────
model Budget {
  id           String   @id @default(cuid())
  academicYear String
  term         Int?     // null = annual budget
  department   String   // legacy free-text — retained; see departmentRef for the structured link
  category     ExpenseCategory
  description  String?
  allocated    Decimal  @db.Decimal(12, 2)
  // R22 (Artefact 8 §12 — critical rule): `spent` remains the authoritative
  // accumulator that budgetService.updateBudgetSpent()/getBudgetVsActual() read
  // and write. It must NOT be removed or reset by this migration.
  spent        Decimal  @db.Decimal(12, 2) @default(0)
  createdByUid String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // R22 — structured references, additive/nullable
  departmentId   String?
  budgetWindowId String?

  departmentRef  Department?              @relation(fields: [departmentId], references: [id])
  budgetWindow   BudgetWindow?            @relation(fields: [budgetWindowId], references: [id])
  commitments    BudgetCommitment[]
  assetRequests  AssetRequest[]
  requisitions   PurchaseRequisition[]
  requisitionLines PurchaseRequisitionLine[]

  @@index([academicYear])
  @@index([departmentId])
  @@index([budgetWindowId])
  @@map("budgets")
}

// ─── SCHOLARSHIP / BURSARY ───────────────────────────────
model Scholarship {
  id           String           @id @default(cuid())
  name         String
  studentId    String
  discountType DiscountType
