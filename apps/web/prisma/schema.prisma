// ─── PENDING ACTIONS (Approval Workflow) ─────────────────
// Stores actions initiated by lower_rank or academic staff that
// require admin / high_rank approval before taking effect.
// entityType + entityId point to the Prisma record being acted on.
// targetState holds the intended payload as JSON (diff or new values).
// The executing service reads targetState and applies it on approval.

model PendingAction {
  id              String              @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  description     String
  requestedByUid  String
  requestedByRole String
  targetState     Json?
  status          PendingActionStatus @default(PENDING)
  reviewedByUid   String?
  reviewedAt      DateTime?
  reviewNotes     String?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([entityType, entityId])
  @@index([requestedByUid])
  @@index([createdAt])
  @@map("pending_actions")
}

enum PendingActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

// ─── SYSTEM SETTINGS ─────────────────────────────────────
// Generic key-value store for all configurable system parameters.
// Each key maps to a typed JSON value; the application layer
// enforces type safety — PostgreSQL stores raw JSON.
// category is a plain string (not an enum) to allow new categories
// without Prisma migrations.
model SystemSettings {
  key          String   @id
  value        Json
  description  String?
  category     String   @default("system")
  isPublic     Boolean  @default(false)  // true = any authenticated user may read
  updatedByUid String?
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

