// ─── LIBRARY WORKFLOWS (Phase D12) ───────────────────────

model ResourceRecommendation {
  id              String   @id @default(cuid())
  requestedByUid  String
  title           String
  author          String?
  isbn            String?
  type            String   // 'BOOK' | 'EBOOK' | 'JOURNAL' | 'OTHER'
  subject         String?
  reason          String
  requesterName   String?  // R21: free-text name as typed on the Recommend a Resource form (requestedByUid already identifies the account; this is display-only)
  requesterRole   String?  // R21: 'Student' | 'Staff' | 'Parent' | 'Other' — self-declared on the form, not derived from the account role
  requesterClass  String?  // R21: class/form/department as typed on the form
  status          String   @default("PENDING")
  reviewedByUid   String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([status])
  @@map("resource_recommendations")
}

model FineWaiverRequest {
  id              String       @id @default(cuid())
  fineId          String
  fine            LibraryFine  @relation(fields: [fineId], references: [id])
  requestedByUid  String
  reason          String
  amount          Decimal      @db.Decimal(10, 2)
  status          String       @default("PENDING")
  reviewedByUid   String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([fineId])
  @@index([status])
  @@map("fine_waiver_requests")
}

  // ─── EXAMS ───────────────────────────────────────────────

model Exam {
  id            String     @id @default(cuid())
  type          ExamType
  subject       String
  classId       String
  class         Class      @relation(fields: [classId], references: [id])
  title         String
  date          DateTime
  timeStart     String
  timeEnd       String
  venue         String
  maxMark       Decimal    @db.Decimal(6,2) @default(100)
  weightPercent Decimal    @db.Decimal(5,2) @default(100)
  // Continuous-assessment slot (1..N, N = SETTING_KEYS.EXAM_CA_COUNT). Set only
  // on WEEKLY_TEST/ASSIGNMENT/QUIZ/MIDTERM exams while CA aggregation is on;
  // it decides which configured CA weight this exam carries in the term
  // result. Null for END_TERM and when aggregation is off. At most one exam per
  // (class, subject, year, term, slot) - NULLs are distinct in Postgres, so
  // unslotted exams never collide.
  caSlot        Int?
  academicYear  String
  term          Int
  status        ExamStatus @default(SCHEDULED)
  createdByUid  String
  marks         ExamMark[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([classId, subject, academicYear, term, caSlot])
  @@index([classId, term])
  @@index([academicYear, term])
  @@map("exams")
}

enum ExamType {
  WEEKLY_TEST
  ASSIGNMENT
  QUIZ
  MIDTERM
  END_TERM
  MANEB_JCE
  MANEB_MSCE
}

enum ExamStatus {
  SCHEDULED
  IN_PROGRESS
  MARKS_PENDING
  MARKS_DRAFT
  MARKS_FINAL
  RESULTS_APPROVED
  RESULTS_RELEASED
}

model ExamMark {
  id           String    @id @default(cuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id])
  studentId    String
  mark         Decimal?  @db.Decimal(6,2)
  absent       Boolean   @default(false)
  comment      String?
  enteredByUid String
  isDraft      Boolean   @default(true)
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

model TermResult {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  academicYear   String
  term           Int
  totalMark      Decimal  @db.Decimal(6,2)
  average        Decimal  @db.Decimal(5,2)
  // JCE track (Forms 1-2) ONLY — the overall letter grade for the term.
  // Always an empty string on the MSCE track: Forms 3-4 have no overall
  // grade, they have an aggregate of points (see aggregatePoints below).
  grade          String
  // MSCE track (Forms 3-4) ONLY — the sum of the point values of the six
  // best subjects (6-54, lower is better). Null when fewer than six
  // subjects were recorded, or on the JCE track where no aggregate exists.
  aggregatePoints   Int?
  // The (up to six) subject names whose points make up aggregatePoints.
  aggregateSubjects Json?
  // 'JCE' | 'MSCE' — which grading system produced this row, persisted so
  // report cards and analytics never have to re-derive it from the class.
  gradingTrack      String?
  position       Int?
  passStatus     Boolean
  subjectResults Json
  attendanceDays Int      @default(0)
  absentDays     Int      @default(0)
  teacherComment String?
  headComment    String?
  reportCardKey  String?
  classPosition    Int       @default(0)
  classTotal       Int       @default(0)
  releasedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacherComments TeacherComment[]

  @@unique([studentId, academicYear, term])
  @@index([classId, academicYear, term])
  @@map("term_results")
}

// ─── TEACHER COMMENT (R8) ─────────────────────────────────
model TeacherComment {
  id           String     @id @default(cuid())
  termResultId String
  termResult   TermResult @relation(fields: [termResultId], references: [id])
