  substatus       String?   // archived_until_escalating | regressed | new | ongoing | ...
  issueCategory   String?   // error | performance | uptime
  isUptimeIssue   Boolean   @default(false)
  eventCount      Int       @default(0)
  userCount       Int       @default(0)
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  permalink       String?
  raw             Json      // normalized full payload, for the detail drawer
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, level])
  @@index([lastSeenAt])
  @@index([isUptimeIssue])
}
model SentryAlertCache {
