# ------------------------------------------------
# SMS MALAWI — apps/web/.env.local (EXAMPLE)
# ------------------------------------------------
# R19: every value below is an OBVIOUS PLACEHOLDER. This file is committed
# under the ".example" convention (safe to commit) and must NEVER contain a
# real, working secret. Copy this file to `.env.local` (git-ignored) and fill
# in real values there, or set them in the Vercel dashboard for deployments.
# ------------------------------------------------

# -- Neon PostgreSQL -------------------------------
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# -- Firebase Client SDK (public — used in browser) -
NEXT_PUBLIC_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<FIREBASE_MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<FIREBASE_APP_ID>
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<FIREBASE_MEASUREMENT_ID>
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<FIREBASE_WEB_PUSH_VAPID_KEY>

# -- Firebase Admin SDK (server-only — never NEXT_PUBLIC_) -
# Provide these three as separate env vars. Do NOT commit a service-account
# JSON file to the repo — getAdminApp() builds credentials from these vars.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<FIREBASE_ADMIN_PRIVATE_KEY>\n-----END PRIVATE KEY-----\n"

# -- API URL ----------------------------------------
# LOCAL DEV: empty string = Next.js routes /api/* internally (no emulator needed)
# VERCEL PROD: leave empty — same domain serves both frontend and API
NEXT_PUBLIC_API_URL=

# -- App URL (production origin, used for links/proxy URLs) -
NEXT_PUBLIC_APP_URL=https://sms-malawi.vercel.app

# -- Firebase Emulator (local dev only) ------------
# true  = auth + firestore talk to local emulators on :9099 and :8080
# false = talk to real Firebase (use for production testing)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# -- Cloudflare R2 file storage ---------------------
# Files are grouped into six buckets by security domain, named
# <R2_BUCKET_PREFIX>-<domain>: public-media, student-records, finance, hr,
# coursework, library. Create them with `pnpm r2:provision`.
# Full walkthrough: apps/web/docs/storage/r2-setup.md
# R2 dashboard -> R2 -> Manage API tokens -> "Object Read & Write", all buckets.
R2_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_PREFIX=sms-malawi
# Optional: override the S3 endpoint (local testing only).
# R2_ENDPOINT=http://localhost:9000

# Public base URL of the ONE public bucket (<prefix>-public-media), no trailing
# slash: an R2 custom domain, or the bucket's r2.dev URL. Every other bucket
# stays private and is served through /api/files/<id>.
R2_PUBLIC_URL_MEDIA=https://<public-media-host>

# -- Email & SMS ------------------------------------
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_WEBHOOK_SECRET=<RESEND_WEBHOOK_SIGNING_SECRET>
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<TWILIO_PHONE_NUMBER>
# Sender: Resend only sends from a domain you own and have verified (Resend -> Domains), or from its
# own test sender onboarding@resend.dev, which delivers ONLY to the email address of your Resend account.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=<SCHOOL NAME> ICT
# A mailbox someone actually reads; replies to the emails land here.
EMAIL_REPLY_TO=<SCHOOL ICT MAILBOX>


# -- Search -----------------------------------------
ALGOLIA_APP_ID=<ALGOLIA_APP_ID>
ALGOLIA_ADMIN_KEY=<ALGOLIA_ADMIN_KEY>

# -- Sentry error tracking --------------------------
NEXT_PUBLIC_SENTRY_DSN=<SENTRY_DSN>
SENTRY_AUTH_TOKEN=<SENTRY_AUTH_TOKEN>

# -- reCAPTCHA -------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<RECAPTCHA_SITE_KEY>

# -- Cron job security -----------------------------
# Sent as Bearer token to cron endpoints — blocks public calls.
# Generate your own with: openssl rand -hex 32
CRON_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>

# -- Upstash Redis (settings cache + audit-log queue) -
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REDIS_REST_TOKEN>

# ─── Feature Flags (Firebase Remote Config fallback values) ───
NEXT_PUBLIC_FEATURE_ALGOLIA_SEARCH=false
NEXT_PUBLIC_FEATURE_FULLCALENDAR=true
NEXT_PUBLIC_FEATURE_MOBILE_NAV=true
NEXT_PUBLIC_FEATURE_PROMOTION_ENGINE=false
NEXT_PUBLIC_FEATURE_ACCOUNTING_LEDGER=true

# -- alpha_admin super user (seed scripts only: `pnpm seed:superadmin`) --
# Unrestricted maintenance/demo account. There is NO default password — set a
# strong secret (12+ chars, not the demo password) in .env.local, never here.
# The account is protected from other admins and is never created without it.
# ALPHA_ADMIN_PASSWORD=<your-own-strong-secret>   # uncomment and set in .env.local
# ALPHA_ADMIN_EMAIL=alpha_admin@chikangawahills-demo.mw
# ALPHA_ADMIN_FIRST_NAME=Alpha
# ALPHA_ADMIN_LAST_NAME=Admin
# ALPHA_ADMIN_SEX=MALE
