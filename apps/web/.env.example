# ------------------------------------------------
# SMS MALAWI — apps/web/.env.local (EXAMPLE)
# ------------------------------------------------
# R19: every value below is an OBVIOUS PLACEHOLDER. This file is committed
# under the ".example" convention (safe to commit) and must NEVER contain a
# real, working secret. Copy this file to `.env.local` (git-ignored) and fill
# in real values there, or set them in the Vercel dashboard for deployments.
# ------------------------------------------------

# -- Neon PostgreSQL -------------------------------
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# -- Firebase Client SDK (public — used in browser) -
NEXT_PUBLIC_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<FIREBASE_MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<FIREBASE_APP_ID>
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<FIREBASE_MEASUREMENT_ID>
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<FIREBASE_WEB_PUSH_VAPID_KEY>

# -- Firebase Admin SDK (server-only — never NEXT_PUBLIC_) -
# Provide these three as separate env vars. Do NOT commit a service-account
# JSON file to the repo — getAdminApp() builds credentials from these vars.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<FIREBASE_ADMIN_PRIVATE_KEY>\n-----END PRIVATE KEY-----\n"

# -- API URL ----------------------------------------
# LOCAL DEV: empty string = Next.js routes /api/* internally (no emulator needed)
# VERCEL PROD: leave empty — same domain serves both frontend and API
NEXT_PUBLIC_API_URL=

# -- App URL (production origin, used for links/proxy URLs) -
NEXT_PUBLIC_APP_URL=https://malawiedustack.eu.org

# -- Firebase Emulator (local dev only) ------------
# true  = auth + firestore talk to local emulators on :9099 and :8080
# false = talk to real Firebase (use for production testing)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# -- Appwrite Storage -------------------------------
# NEXT_PUBLIC_ versions used by browser SDK for file viewing
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<APPWRITE_PROJECT_ID>
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=your-project

# Server-only version (no NEXT_PUBLIC_) used by node-appwrite in API routes
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<APPWRITE_PROJECT_ID>
APPWRITE_API_KEY=<APPWRITE_API_KEY>

# -- Email & SMS ------------------------------------
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_WEBHOOK_SECRET=<RESEND_WEBHOOK_SIGNING_SECRET>
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<TWILIO_PHONE_NUMBER>
EMAIL_FROM_ADDRESS=noreply@mail.malawiedustack.eu.org
EMAIL_FROM_NAME=SMS Malawi
EMAIL_REPLY_TO=noreply@your-domain.example

# -- Search -----------------------------------------
ALGOLIA_APP_ID=<ALGOLIA_APP_ID>
ALGOLIA_ADMIN_KEY=<ALGOLIA_ADMIN_KEY>

# -- Sentry error tracking --------------------------
NEXT_PUBLIC_SENTRY_DSN=<SENTRY_DSN>
SENTRY_AUTH_TOKEN=<SENTRY_AUTH_TOKEN>

# -- reCAPTCHA -------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<RECAPTCHA_SITE_KEY>

# -- Cron job security -----------------------------
# Sent as Bearer token to cron endpoints — blocks public calls.
# Generate your own with: openssl rand -hex 32
CRON_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>

# -- Upstash Redis (settings cache + audit-log queue) -
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REDIS_REST_TOKEN>

# ─── Feature Flags (Firebase Remote Config fallback values) ───
NEXT_PUBLIC_FEATURE_ALGOLIA_SEARCH=false
NEXT_PUBLIC_FEATURE_FULLCALENDAR=true
NEXT_PUBLIC_FEATURE_MOBILE_NAV=true
NEXT_PUBLIC_FEATURE_PROMOTION_ENGINE=false
NEXT_PUBLIC_FEATURE_ACCOUNTING_LEDGER=true