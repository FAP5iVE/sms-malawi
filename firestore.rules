rules_version = '2';

/**
 * firestore.rules — SMS Malawi Firestore Security Rules
 *
 * Collections managed here:
 *   attendance/{classId}/records/{date}      — legacy; SERVER-ONLY (deny all client access)
 *   announcements/{announcementId}           — school-wide and class announcements
 *   notifications/{userId}/items/{notifId}   — per-user in-app feed; SERVER-ONLY (deny all client access)
 *   calendar_events/{eventId}                — school calendar events
 *   user_fcm_tokens/{uid}                    — FCM push tokens (Admin SDK only)
 *   sessions/{uid}                           — legacy; SERVER-ONLY (deny all client access)
 *   security_events/{eventId}                — failed logins / anomalous activity
 *
 * Security model:
 *   • Authentication is required for every read/write unless explicitly noted.
 *   • Role is read from Firebase Custom Claims (token.role) — not from a user
 *     document — to prevent privilege escalation via Firestore writes.
 *   • user_fcm_tokens and security_events are server-only (deny all client access).
 *     These are written exclusively by Firebase Admin SDK in push.ts / server routes.
 *   • The catch-all deny rule at the bottom ensures no unlisted collection is
 *     accidentally accessible.
 *
 * Role hierarchy (matches packages/shared/types/roles.ts):
 *   admin > high_rank > finance / library / lower_rank / academic / hr / exam_officer > student
 *
 * Phase B9 changes:
 *   • Added user_fcm_tokens rules (deny all client access — Admin SDK only)
 *   • Added sessions rules (user reads/writes own; admin reads all)
 *   • Added security_events rules (deny client writes; admin reads)
 *   • Enhanced attendance rules (added LATE status, date validation)
 *   • Enhanced announcements rules (added scheduledAt / expiresAt / status fields)
 *   • Enhanced notifications rules (added mark-all-read and delete own)
 *   • Added calendar_events audience filtering helpers
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ─────────────────────────────────

    /** Returns true if the request is from an authenticated user. */
    function isAuth() {
      return request.auth != null;
    }

    /** Returns the authenticated user's role custom claim (string). */
    function role() {
      return request.auth.token.role;
    }

    /** The requesting user's Firebase UID. */
    function uid() {
      return request.auth.uid;
    }

    /**
     * The alpha_admin super user: carries the `superUser: true` custom claim
     * (set only by the Admin SDK — see packages/shared/constants/superUser.ts).
     * Passes every role helper below. `.get(key, default)` keeps this safe
     * for the vast majority of tokens that have no such claim at all.
     */
    function isSuper() {
      return isAuth() && request.auth.token.get('superUser', false) == true;
    }

    function isAdmin() {
      return isSuper() || (isAuth() && role() == 'admin');
    }

    function isHighRankOrAdmin() {
      return isSuper() || (isAuth() && role() in ['admin', 'high_rank']);
    }

    /** All staff roles — everyone except students. */
    function isStaff() {
      return isSuper() || (isAuth() && role() in [
        'admin', 'high_rank', 'finance', 'library',
        'lower_rank', 'academic', 'hr', 'exam_officer',
      ]);
    }

    function isStudent() {
      return isSuper() || (isAuth() && role() == 'student');
    }

    // ── ATTENDANCE ────────────────────────────────────────
    // Collection path: attendance/{classId}/records/{date}
    //
    // ⚠ SERVER-ONLY COLLECTION — DENY ALL CLIENT ACCESS ⚠  [Issue 2]
    //
    // Attendance now lives in Postgres (Attendance model) and is read/written
    // exclusively through the Express routes in server/routes/attendance.ts
    // (attendanceService.ts). Nothing in the client or server reads or writes
    // this Firestore collection any more, so it is closed to all client access.
    //
    // Why deny rather than patch the old rules:
    //   • The legacy document shape stores every student's status in ONE
    //     document, so a rule can neither redact other students' fields nor
    //     scope a student to "their own" attendance — any read grant would
    //     expose the whole class register.
    //   • Class/subject assignment lives in Postgres (Class.teacherId), which
    //     rules cannot see; a role-only claim check cannot prove the writer is
    //     assigned to the class. Authorization stays in one place: the
    //     requirePermission + class-ownership guards in the Express routes.
    //   • Any legacy documents that still exist are reachable only via the
    //     Admin SDK (which bypasses these rules). Physical deletion is
    //     therefore no longer possible from a client; voiding/corrections go
    //     through the audited server path.
    //
    // If live attendance updates are ever needed again, design a per-student
    // document model and server-synced claims first, with Emulator tests.

    match /attendance/{classId}/records/{date} {
      allow read, write: if false;
    }

    // ── ANNOUNCEMENTS ─────────────────────────────────────
    // Collection path: announcements/{announcementId}
    //
    // ⚠ SERVER-ONLY COLLECTION — DENY ALL CLIENT ACCESS ⚠  [N2]
    //
    // As of the N2 remediation, both reads and writes go exclusively through
    // the backend (Admin SDK, which is NOT subject to these rules):
    //   • Reads:   GET /announcements, GET /announcements/pending
    //              (permission-gated in Express: announcement.view /
    //              announcement.approvePublish)
    //   • Writes:  POST /announcements, PATCH /:id, PATCH /:id/approve,
    //              DELETE /:id
    //
    // The client no longer reads Firestore directly (useAnnouncements.ts is
    // now a TanStack Query hook over the routes above). Denying all client
    // access here removes the entire class of outage where a status-vocabulary
    // drift or a single malformed document caused a blanket permission-denied
    // on the client read path, and means announcement visibility is governed
    // by the same permission system as every other domain rather than by a
    // hand-maintained parallel copy of the matrix in this file.

    match /announcements/{announcementId} {
      allow read, write: if false;
    }

    // ── NOTIFICATIONS (PER-USER FEED) ─────────────────────
    // Collection path: notifications/{userId}/items/{notifId}
    //
    // ⚠ SERVER-ONLY COLLECTION — DENY ALL CLIENT ACCESS ⚠  [Issue 3]
    //
    // Document shape (written by notificationFeedService.ts via the Admin SDK):
    //   {
    //     title:     string,
    //     body:      string,
    //     type:      'INFO' | 'WARNING' | 'SUCCESS' | 'ERROR',
    //     category:  string (e.g. 'fee_reminder', 'result_release', 'assignment'),
    //     read:      boolean,
    //     actionUrl: string | null (internal path only),
    //     createdAt: Timestamp,
    //     readAt:    Timestamp | null,
    //   }
    //
    // Every notification producer (fees, results, leave, placement, library,
    // assignments, announcements, approvals) runs server-side and writes
    // through notificationFeedService; the client reads and marks read via
    // GET /notifications/feed, PATCH /notifications/feed/read-all and
    // PATCH /notifications/feed/:id/read. No client code touches this
    // collection, so all client access is denied:
    //   • Previously `allow create: if isStaff()` let ANY staff role write a
    //     forged "system" notification (fake fee reminder, fake result
    //     release, phishing link) into ANY user's feed, with no schema,
    //     recipient or source-event check.
    //   • The Admin SDK bypasses these rules, so server-side creation,
    //     idempotent fan-out (pushToManyFeedsOnce) and mark-read are unaffected.
    //   • Owner read / mark-read / delete are also denied: they are served by
    //     the API, and a direct-write path would bypass its field validation.
    //
    // If a future feature genuinely needs direct client writes, add a narrow
    // rule (specific permission, target group, field allowlist, length limits,
    // server-set timestamps) with Emulator tests rather than re-opening isStaff().

    match /notifications/{userId}/items/{notifId} {
      allow read, write: if false;
    }

    // ── CALENDAR EVENTS ───────────────────────────────────
    // Collection path: calendar_events/{eventId}
    //
    // Document shape:
    //   {
    //     title:        string,
    //     description:  string,
    //     startDate:    Timestamp,
    //     endDate:      Timestamp,
    //     type:         'EXAM' | 'HOLIDAY' | 'TERM' | 'STAFF_LEAVE' | 'LAB' | 'ANNOUNCEMENT',
    //     classId:      string | null,
    //     createdByUid: string,
    //     isPublic:     boolean,
    //     colour:       string | null,
    //   }

    match /calendar_events/{eventId} {
      // [Issue 7] SERVER-ONLY. The calendar is served by the API
      // (/api/calendar/* -> Prisma, with per-role audience filtering and the
      // calendar.createEvent/editEvent/deleteEvent permissions). Nothing in the app
      // reads or writes this collection from the client, yet the previous rules let
      // every staff role read all events and create/edit/delete them directly with the
      // public Web API key — bypassing both the permission checks and audience scoping.
      allow read, write: if false;
    }

    // ── FCM PUSH TOKENS ───────────────────────────────────
    // Collection path: user_fcm_tokens/{uid}
    //
    // ⚠ SERVER-ONLY COLLECTION — DENY ALL CLIENT ACCESS ⚠
    //
    // This collection is exclusively managed by Firebase Admin SDK in push.ts:
    //   registerToken(), unregisterToken(), getTokensForUser(), removeInvalidTokens()
    //
    // Rationale for complete client denial:
    //   • FCM tokens are sensitive device identifiers — exposing them to the client
    //     could allow token enumeration or token hijacking attacks.
    //   • Even reading own tokens is denied: the client doesn't need to know
    //     its own token after registering it; it obtains a fresh token via
    //     getToken() when needed.
    //   • Token registration/unregistration happens via authenticated server
    //     endpoints (/notifications/register-token, /notifications/unregister-token)
    //     which call the Admin SDK on the server.
    //
    // If you need to verify a token exists, use GET /notifications/token-status.

    match /user_fcm_tokens/{uid} {
      allow read, write: if false;
    }

    // ── ACTIVE SESSIONS ───────────────────────────────────
    // Collection path: sessions/{sessionUid}
    //
    // ⚠ SERVER-ONLY COLLECTION — DENY ALL CLIENT ACCESS ⚠  [Issue 4]
    //
    // Session tracking is Postgres-backed (UserSession model), written only
    // by the Express API through sessionService.ts:
    //   • POST /auth/log-login-success → recordLogin()   (server-authoritative:
    //       uid, role snapshot from the VERIFIED token, loginAt, ipAddress from
    //       the trusted proxy hop via req.ip)
    //   • POST /auth/heartbeat         → heartbeat()      (client heartbeat:
    //       bumps lastSeenAt only, stamped with the SERVER clock)
    //   • POST /auth/log-logout        → recordLogout()   (endReason 'logout')
    //   • POST /sessions/:uid/force-logout → forceLogout() (admin only;
    //       calls revokeRefreshTokens(uid) and verifyAuth checks revocation,
    //       so a revoked session really fails — not just a UI record)
    //   • GET  /sessions[...]          → admin-only monitoring reads
    //       (userMgmt.viewActiveSessions)
    // userAgent is client-supplied and should be treated as unverified.
    //
    // Nothing in the client or server reads or writes this Firestore
    // collection any more. The previous rules let any signed-in user create or
    // overwrite their own document (including role, ipAddress and loginAt) and
    // delete it — none of which is trustworthy evidence of a real session, and
    // deleting a document never revoked anything. All client access is denied;
    // the Admin SDK bypasses these rules.

    match /sessions/{sessionUid} {
      allow read, write: if false;
    }

    // ── SECURITY EVENTS ───────────────────────────────────
    // Collection path: security_events/{eventId}
    //
    // Document shape:
    //   {
    //     type:          'FAILED_LOGIN' | 'SUSPICIOUS_ACTIVITY' | 'FORCE_LOGOUT' | 'ROLE_CHANGE',
    //     actorUid:      string | null (null for unauthenticated events like failed logins),
    //     targetUid:     string | null,
    //     ipAddress:     string | null,
    //     userAgent:     string | null,
    //     description:   string,
    //     severity:      'LOW' | 'MEDIUM' | 'HIGH',
    //     createdAt:     Timestamp,
    //   }
    //
    // ⚠ SERVER-ONLY WRITES — Admin reads only ⚠
    //
    // Security events are written exclusively by:
    //   • Firebase Auth triggers (failed login, password reset) via Admin SDK
    //   • Server-side route handlers (role change, suspicious request patterns)
    //   • Cron jobs (brute force detection aggregation)
    //
    // Client writes are denied to prevent log tampering.
    // Only admin can read security events (Security Center — GAP-091).

    match /security_events/{eventId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── CATCH-ALL DENY ────────────────────────────────────
    // Any collection not explicitly listed above is denied.
    // This prevents accidental exposure of data in collections created during
    // development or testing that haven't been assigned explicit rules yet.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
